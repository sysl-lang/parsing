module sh.sysl.parsing

import sysl.buf.{Buf, buf}
import sysl.slices.contains
import sysl.text.{Ascii, char_from_u32, from_utf8_unchecked, parse_real, str_builder}

// Numbers and quoted text, read off a `Scanner`.
//
// **This is the part of a lexer that is the same in every grammar and wrong in most of them.** The
// digits are easy; what is not is the overflow that has to be caught before the arithmetic that
// would wrap, the underscore that may separate digits and may not lead them, the escape that runs
// off the end of the input, and the surrogate pair that JSON writes and UTF-8 does not have. Each of
// those is a line of code and a day of somebody's life.
//
// **What is not here is policy.** Whether a language has binary literals, whether `1_000` is a
// number, whether a string may span a line, whether `\e` is an escape -- those are the grammar's
// answers, not this package's. So the readers below take the *shape* they are asked for and the
// caller decides what to call: a JSON reader consumes its own `\u` escapes with `read_escape`
// because JSON's set is C's minus most of it, and refuses a leading zero itself because that is
// JSON's rule and nothing here has an opinion about it.

// Why a literal was refused.
//
// **Every one of them carries a `Span` and not an offset**, which is the whole difference between a
// caret under one character and a caret under the thing that was wrong. `\q` is two bytes and gets
// two; `\ud83d` with no low surrogate after it is six and gets six; `0x` with no digits is two. An
// offset would have been enough to *say where* and is not enough to draw, and a reader who is being
// shown their own text is looking at the underline rather than at the line and column.
//
// It is the same shape the sysl compiler's own `Pos` has -- a start **and** an end -- for the same
// reason.
//
// A span may still be **empty**, and that is a different statement rather than a missing end: it
// says something is *absent* at that point rather than wrong across an extent, and `diag` draws one
// caret for it because a message pointing at zero characters points at nothing.
enum LitError
    // A prefix with no digits after it -- the span is the prefix, `0x`, or the empty place the
    // digits should have started.
    NoDigits(span: Span)
    // A digit outside the base, or an underscore where a digit was needed.
    BadDigit(span: Span)
    // The value does not fit 64 bits. The span is the whole number, since that is what has to be
    // changed.
    Overflow(span: Span)
    // A quote, or an escape, that the end of the input arrived in the middle of. The span runs from
    // where the thing opened to where the input ran out, which is what says what was left unclosed.
    Unterminated(span: Span)
    // The cursor was not on the opening quote the reader was told to expect.
    NoQuote(span: Span)
    // A backslash followed by something that is not an escape. The span is the whole escape as far
    // as it was read.
    BadEscape(span: Span)
    // An escape naming a value that is not a character: past U+10FFFF, or a lone surrogate. The span
    // is the whole escape, so a reader sees the digits that named it.
    BadCodepoint(span: Span)
    // A float whose shape scanned and whose value would not convert, which is the machine's limit
    // rather than the input's mistake.
    BadReal(span: Span)
end LitError

impl Display for LitError
    display(self, out: *Writer, fmt: FormatSpec)
        val text = self match
            NoDigits(_) -> "no digits"
            BadDigit(_) -> "not a digit"
            Overflow(_) -> "the number is too large to hold"
            Unterminated(_) -> "unterminated"
            NoQuote(_) -> "not a quoted literal"
            BadEscape(_) -> "not an escape"
            BadCodepoint(_) -> "not a character"
            BadReal(_) -> "not a number this machine can hold"

        display_str(text, out, fmt)
    end display

// Where a refusal happened, for a caller assembling a diagnostic out of one.
where(e: LitError) -> Span
    e match
        NoDigits(s) -> s
        BadDigit(s) -> s
        Overflow(s) -> s
        Unterminated(s) -> s
        NoQuote(s) -> s
        BadEscape(s) -> s
        BadCodepoint(s) -> s
        BadReal(s) -> s
end where

// What a number turned out to be.
//
// The two are one reader because a grammar cannot know which it is looking at until it has read
// past the digits: `1` and `1.5` and `1e9` all begin the same way, and a lexer that committed to an
// integer at the first digit has to put it back.
enum Number
    Int(v: ulong)
    Real(v: real)
end Number

impl Eq for Number
    eq(self, rhs: Number) -> bool
        self match
            Int(a) ->
                rhs match
                    Int(b) -> a == b
                    _ -> false
            Real(a) ->
                rhs match
                    Real(b) -> a == b
                    _ -> false
    end eq

impl Display for Number
    display(self, out: *Writer, fmt: FormatSpec)
        self match
            Int(v) -> display_str(str(v), out, fmt)
            Real(x) -> display_str(str(x), out, fmt)
    end display

// One byte, as a span: the smallest thing there is to underline, and what a mistake about a single
// character reports. It is a function rather than `Span(at, at + 1)` written out at seven call sites,
// since the two numbers being adjacent is the whole of what it says.
private one_at(at: usize) -> Span = Span(at, at + 1)

// The largest value the accumulation may hold. Written as a `val` with the type on it because
// `18446744073709551615` is not an `int` and cannot be one.
private val ulong_max: ulong = 18446744073709551615

// A run of digits in a base, with underscores allowed between them.
//
// **The overflow test happens before the arithmetic that would overflow**, because integer
// arithmetic wraps rather than trapping: an accumulator that has already wrapped is not a number a
// later comparison can learn anything from. This is the same reasoning `sysl.text.parse_ulong_base`
// is written around, and the answer is the same one -- ask whether the multiply and the add would
// fit, before doing them.
//
// **An underscore must sit between two digits.** `1_000` is a number and `_1`, `1_` and `1__0` are
// not, which is the rule Rust, Ada and sysl itself all keep: a separator that may lead or trail is
// one that can be typed by accident and read as nothing.
read_digits(s: *Scanner, base: int) -> Result[ulong, LitError]
    val start = s.offset
    var v: ulong = 0
    var digits: usize = 0

    loop
        s.peek() match
            Some(c) ->
                if c == u8('_') then
                    if digits == 0 then return Err(BadDigit(one_at(s.offset)))

                    s.bump()

                    // A separator has to be followed by a digit, so the byte after it is looked at
                    // here rather than left to the next turn of the loop -- where the run simply
                    // ending would have looked like a legal number.
                    s.peek() match
                        Some(d) ->
                            if d.digit_value(base).is_none() then return Err(BadDigit(one_at(s.offset)))
                        // The input ended after the separator, so there is no byte to underline and
                        // the span is the empty place a digit should have been.
                        None -> return Err(BadDigit(point(s.offset)))
                else
                    c.digit_value(base) match
                        Some(d) ->
                            val b = ulong(base)
                            val dv = ulong(d)

                            if v > (ulong_max - dv) / b then
                                // The rest of the run belongs to the number the caller wrote, so it
                                // is consumed before reporting -- otherwise the grammar resumes in
                                // the middle of the digits and reports a second error about them.
                                s.accept_while((x) -> x == u8('_') || x.digit_value(base).is_some())
                                return Err(Overflow(s.span_from(start)))

                            v = v * b + dv
                            digits += 1
                            s.bump()
                        None -> break
            None -> break

    if digits == 0 then Err(NoDigits(point(start))) else Ok(v)
end read_digits

// An integer, with the radix prefix if it has one.
//
// `0x`/`0X` is hexadecimal, `0o`/`0O` octal, `0b`/`0B` binary, and anything else decimal -- which
// makes a leading zero an ordinary decimal digit rather than C's octal. A language wanting C's rule
// reads the zero itself and calls `read_digits(s, 8)`; a language wanting JSON's, where a leading
// zero is refused outright, tests for it before calling this. Neither is a flag here.
read_integer(s: *Scanner) -> Result[ulong, LitError]
    if s.peek() == Some(u8('0')) then
        s.peek_at(1) match
            Some(p) ->
                val base = if p == u8('x') || p == u8('X') then
                        16
                    elif p == u8('o') || p == u8('O') then
                        8
                    elif p == u8('b') || p == u8('B') then
                        2
                    else
                        0

                if base != 0 then
                    val from = s.offset

                    s.skip(2)

                    // `0x` with nothing after it is a two-byte mistake, and the digits that are
                    // missing have no span of their own -- so the prefix is what gets underlined.
                    return read_digits(s, base) match
                        Err(NoDigits(_)) -> Err(NoDigits(Span(from, from + 2)))
                        other -> other
            None -> ()

    read_digits(s, 10)
end read_integer

// An integer or a float, decided by what follows the digits.
//
// A `.` is part of the number only when a digit follows it, so `1.max()` and `0..<n` read as an
// integer and then something else -- which is the rule sysl's own lexer keeps and the reason a
// range does not have to be written with a space in it. An `e` is part of it only when digits, or a
// sign and then digits, follow.
//
// **Neither path allocates unless the float was written with separators in it.** A float's value
// has to come from `strtod`, which reads text -- but the run in the input is already the text, so it
// goes straight there; only `1_000.5` is copied, to take the underscores out. The integers are
// accumulated in place. Correct rounding is worth a copy where one is needed, and writing a
// decimal-to-binary conversion by hand is how a language ends up with `0.1 + 0.2` disagreeing with
// every other language on the machine.
//
// **It cost three allocations until sysl 0.0.76, and this file is what said so.** The `parse_*`
// family took a `string`, so the stripped run had to be built into one and `strtod` then wanted a
// NUL-terminated copy of that -- three pieces of heap for a value whose text is a dozen bytes. The
// family grew a `[]const u8` form, so the buffer above goes straight to it and the terminator is
// written into a stack array.
read_number(s: *Scanner) -> Result[Number, LitError]
    val start = s.offset
    var real_shaped = false

    read_integer(s) match
        Ok(v) ->
            // A prefixed literal is an integer and nothing else: `0x1.8p3` is C's hexadecimal float
            // and is not something this reads.
            if s.offset - start >= 2 && s.src[start] == u8('0') && !s.src[start + 1].is_digit() then
                return Ok(Int(v))

            if s.peek() == Some(u8('.')) then
                s.peek_at(1) match
                    Some(d) ->
                        if d.is_digit() then
                            real_shaped = true
                            s.bump()

                            read_digits(s, 10) match
                                Err(e) -> return Err(e)
                                Ok(_) -> ()
                    None -> ()

            s.peek() match
                Some(e) ->
                    if e == u8('e') || e == u8('E') then
                        val after = s.peek_at(1)
                        val signed = after == Some(u8('+')) || after == Some(u8('-'))
                        val first = if signed then s.peek_at(2) else after

                        first match
                            Some(d) ->
                                if d.is_digit() then
                                    real_shaped = true
                                    s.skip(if signed then 2 else 1)

                                    read_digits(s, 10) match
                                        Err(er) -> return Err(er)
                                        Ok(_) -> ()
                            None -> ()
                None -> ()

            if !real_shaped then return Ok(Int(v))

            val span = s.span_from(start)

            to_real(s.src[span.start..<span.end]) match
                Some(x) -> Ok(Real(x))
                None -> Err(BadReal(span))
        Err(e) -> Err(e)
end read_number

// The text of a float through the library's one converter, with any separators taken out.
//
// **A run with no `_` in it goes straight to the converter and is not copied**, which is nearly
// every float anybody writes; only a separated one costs the buffer, and only because `strtod` would
// stop at the underscore and report the rest as trailing garbage.
private to_real(run: []const u8) -> Option[real]
    if !contains(run, u8('_')) then return real_of(run)

    var b: Buf[u8] = buf()

    for i in 0..<run.len
        if run[i] != u8('_') then b.push(run[i])

    real_of(b.view())
end to_real

// The converter's `Result` as an `Option`. Which refusal it was does not survive, and does not need
// to: the run was scanned as a number, so the only thing left for the converter to object to is a
// value this machine cannot hold -- which is what the caller reports as `BadReal`.
private real_of(text: []const u8) -> Option[real]
    parse_real(text) match
        Ok(x) -> Some(x)
        Err(_) -> None

// -- quoted text ----------------------------------------------------------------------------------

// One escape, with the cursor on the backslash.
//
// **The set is the C family's**, which is what sysl, JSON, Java, JavaScript, Rust, Go and every
// config format that has escapes at all took theirs from: `\\ \" \' \` \/ \0 \a \b \e \f \n \r \t
// \v`, plus `\xHH`, `\u{H..H}` and the four-digit `\uHHHH`. A grammar wanting fewer tests the byte
// after the backslash itself; a grammar wanting more reads its own and falls back to this.
//
// **`\uHHHH` pairs surrogates, and that is the whole reason it is worth having.** UTF-16 is the only
// encoding that needs a pair and JSON is written in terms of it, so `"😀"` is one emoji
// and not two errors -- while a lone `\ud83d` is refused, because there is no character there to
// answer with. Nothing else on the machine gets this right by accident.
//
// **`\xHH` is a codepoint, not a byte.** `\xff` is U+00FF and encodes as the two bytes UTF-8 gives
// it, rather than one byte 0xFF that would make the text invalid. A grammar that wants arbitrary
// bytes in a literal is asking for a byte string, which is a different reader.
read_escape(s: *Scanner) -> Result[char, LitError]
    val start = s.offset

    if !s.accept(u8('\\')) then return Err(BadEscape(one_at(start)))

    s.next() match
        None -> Err(Unterminated(s.span_from(start)))
        Some(c) ->
            if c == u8('n') then
                Ok('\n')
            elif c == u8('t') then
                Ok('\t')
            elif c == u8('r') then
                Ok('\r')
            elif c == u8('0') then
                Ok(char(0u32))
            elif c == u8('a') then
                Ok(char(7u32))
            elif c == u8('b') then
                Ok(char(8u32))
            elif c == u8('f') then
                Ok(char(12u32))
            elif c == u8('v') then
                Ok(char(11u32))
            elif c == u8('e') then
                Ok(char(27u32))
            elif c == u8('\\') || c == u8('"') || c == u8('\'') || c == u8('`') || c == u8('/') then
                Ok(char(u32(c)))
            elif c == u8('x') then
                read_hex(s, 2, start) match
                    Ok(v) -> to_char(s, v, start)
                    Err(e) -> Err(e)
            elif c == u8('u') then
                read_u_escape(s, start)
            elif c == u8('U') then
                // **C's other universal character name, and the one this set was missing.** The
                // comment above says these are the C family's escapes; C99 has both `\uHHHH` and
                // `\UHHHHHHHH`, and Python, Rust and TOML all write the eight-digit form for a
                // codepoint past the basic plane. Its absence made `\U0001F600` read as `\U` --
                // which was refused as an unknown escape, so nothing was silently wrong; it simply
                // could not be written.
                read_hex_escape(s, 8, start)
            else
                // The offending byte has been consumed, so the span covers the backslash and it
                // together -- `\q` underlined, rather than a caret under the backslash alone.
                Err(BadEscape(s.span_from(start)))
end read_escape

// The `\u` half, which is two different escapes wearing one letter.
private read_u_escape(s: *Scanner, start: usize) -> Result[char, LitError]
    if s.accept(u8('{')) then
        var v: u32 = 0
        var n = 0

        while !s.at_end() && s.peek() != Some(u8('}'))
            s.next() match
                Some(c) ->
                    c.digit_value(16) match
                        Some(d) ->
                            n += 1

                            if n > 6 then return Err(BadCodepoint(s.span_from(start)))

                            v = v * 16 + u32(d)
                        None -> return Err(BadCodepoint(s.span_from(start)))
                None -> ()

        if !s.accept(u8('}')) then return Err(Unterminated(s.span_from(start)))
        if n == 0 then return Err(NoDigits(s.span_from(start)))

        return to_char(s, v, start)

    read_hex(s, 4, start) match
        Err(e) -> Err(e)
        Ok(hi) ->
            // A high surrogate is half of a character, so the other half has to be there. `\ud83d`
            // alone is refused rather than turned into U+FFFD: this reads a literal, and a literal
            // that says half a character is a mistake in the text rather than damage to it.
            if hi >= 0xD800u32 && hi <= 0xDBFFu32 then
                if !s.accept_seq("\\u".bytes) then return Err(BadCodepoint(s.span_from(start)))

                read_hex(s, 4, start) match
                    Err(e) -> Err(e)
                    Ok(lo) ->
                        if lo < 0xDC00u32 || lo > 0xDFFFu32 then return Err(BadCodepoint(s.span_from(start)))

                        to_char(s, 0x10000u32 + ((hi - 0xD800u32) << 10) + (lo - 0xDC00u32), start)
            else
                to_char(s, hi, start)
end read_u_escape

/** Exactly `n` hexadecimal digits, and the character they name, with the cursor on the first digit.
 *
 * **This is `read_escape`'s own machinery, made public because a grammar's escape set is the
 * grammar's business.** A language whose escapes are not C's cannot call `read_escape` at all -- TOML
 * has nine where this file knows sixteen, and JSON has eight -- so it checks the byte after the
 * backslash itself and then needs exactly this: `n` digits, and the refusal of anything that is not a
 * character. Written by hand at each such grammar it is four lines and one of them is the surrogate
 * test, which is the line that gets left out.
 *
 * `start` is where the escape began, so that a bad one is underlined from its backslash rather than
 * from the digit that gave it away.
 *
 *     if s.accept_seq("\\u".bytes) then read_hex_escape(s, 4, at)
 */
read_hex_escape(s: *Scanner, n: int, start: usize) -> Result[char, LitError] =
    to_char(s, read_hex(s, n, start)?, start)

// Exactly `n` hexadecimal digits, which is what the fixed-width escapes take -- a short run is the
// input's mistake and not a shorter number.
private read_hex(s: *Scanner, n: int, start: usize) -> Result[u32, LitError]
    var v: u32 = 0

    for _ in 0..<n
        s.next() match
            None -> return Err(Unterminated(s.span_from(start)))
            Some(c) ->
                c.digit_value(16) match
                    Some(d) -> v = v * 16 + u32(d)
                    None -> return Err(BadDigit(one_at(s.offset - 1)))

    Ok(v)
end read_hex

private to_char(s: *Scanner, v: u32, start: usize) -> Result[char, LitError]
    char_from_u32(v) match
        Some(c) -> Ok(c)
        None -> Err(BadCodepoint(s.span_from(start)))

// A quoted literal, with the cursor on the opening quote, handed back with its escapes decoded.
//
// The quote character is a parameter because which one a language uses -- and how many -- is the
// language's business: `"` and `'` for most, `` ` `` for a raw form, and a grammar with two calls
// this twice.
//
// **A newline inside is allowed and is not this reader's decision either.** A language that ends a
// string at the end of the line tests for one itself; what is refused here is only the input
// running out, because at that point there is nothing left to decide.
read_quoted(s: *Scanner, quote: u8) -> Result[string, LitError]
    val start = s.offset

    if !s.accept(quote) then return Err(NoQuote(one_at(start)))

    var b = str_builder()

    loop
        s.peek() match
            None -> return Err(Unterminated(s.span_from(start)))
            Some(c) ->
                if c == quote then
                    s.bump()
                    break
                elif c == u8('\\') then
                    read_escape(s) match
                        Err(e) -> return Err(e)
                        Ok(ch) -> b.push_char(ch)
                else
                    s.next_char() match
                        Some(ch) -> b.push_char(ch)
                        None -> return Err(Unterminated(s.span_from(start)))

    Ok(b.finish())
end read_quoted

// A quoted literal with expressions written into it, taken apart.
//
// **`chunks` is one longer than `holes`**, which is the whole shape: a run of literal text before
// each hole and one after the last, any of which may be empty. `s"${a}${b}"` is three empty chunks
// and two holes.
struct Interpolation
    // The literal text between the holes, escapes already decoded.
    chunks: Buf[string]

    // Where each hole's expression is, as offsets into the input the scanner is walking -- so the
    // caller can hand the grammar a slice whose spans still point at the file the reader is looking
    // at. See `sub_source`.
    holes: Buf[Span]
end Interpolation

// A quoted literal that may have expressions written into it, with the cursor on the opening quote.
//
// **What is genuinely hard here is knowing which `}` closes a hole**, and it is why this is not four
// lines in every grammar that wants it: a brace inside the hole nests, and a brace inside a *string*
// inside the hole is not a brace at all. `s"${ f("}") }"` closes where a reader says it does, and a
// scanner that counted braces alone would stop in the middle of the argument.
//
// **The opener and closer are the caller's**, because which sigil a language spends on this is the
// language's business -- `${` in Scala, JavaScript and slate, `#{` in Ruby, a bare `{` in Python.
// Nesting is counted on the last byte of `open` against `close`, so the pair must bracket.
//
// **What comes back is extents and text, not meaning.** This reader does not know what a hole says;
// it knows where one starts and stops, which is the part every grammar gets wrong the same way.
read_interpolated(s: *Scanner, quote: u8, open: []const u8, close: u8) -> Result[Interpolation, LitError]
    val start = s.offset

    if !s.accept(quote) then return Err(NoQuote(one_at(start)))

    if open.len == 0 then return Err(NoQuote(one_at(start)))

    val nest = open[open.len - 1]
    var chunks: Buf[string] = buf()
    var holes: Buf[Span] = buf()
    var b = str_builder()

    loop
        s.peek() match
            None -> return Err(Unterminated(s.span_from(start)))
            Some(c) ->
                if c == quote then
                    s.bump()
                    break
                elif c == u8('\\') then
                    read_escape(s) match
                        Err(e) -> return Err(e)
                        Ok(ch) -> b.push_char(ch)
                elif open.len > 0 && c == open[0] && s.peek_at(1) == Some(open[0]) then
                    // **A doubled sigil is the sigil**, which is the only way to write one where a
                    // hole would otherwise open -- `$$` for `${`, and `{{` for a bare `{`, which is
                    // Scala's rule and Python's respectively falling out of the same line.
                    s.bump()
                    s.bump()
                    b.push_char(char(u32(open[0])))
                elif s.starts_with(open) then
                    for _ in 0..<open.len
                        s.bump()

                    val from = s.offset

                    read_hole(s, nest, close, start)?
                    holes.push(Span(from, s.offset - 1))
                    chunks.push(b.finish())
                    b = str_builder()
                else
                    s.next_char() match
                        Some(ch) -> b.push_char(ch)
                        None -> return Err(Unterminated(s.span_from(start)))

    chunks.push(b.finish())
    Ok(Interpolation(chunks, holes))
end read_interpolated

// Step over one hole, leaving the cursor just past the byte that closed it.
//
// The depth is what a nested bracket needs and the inner loop is what a nested string needs; without
// the second, a quote in the hole would hide every bracket after it.
private read_hole(s: *Scanner, nest: u8, close: u8, start: usize) -> Result[unit, LitError]
    var depth: usize = 1

    loop
        s.peek() match
            None -> return Err(Unterminated(s.span_from(start)))
            Some(c) ->
                if c == nest then
                    depth += 1
                    s.bump()
                elif c == close then
                    depth -= 1
                    s.bump()

                    if depth == 0 then return Ok(())
                elif c == u8('"') || c == u8('\'') then
                    // A string inside the hole, whose brackets are its own. Its escapes are stepped
                    // over rather than read, since what is wanted is where it ends.
                    val opened = c

                    s.bump()

                    loop
                        s.peek() match
                            None -> return Err(Unterminated(s.span_from(start)))
                            Some(q) ->
                                s.bump()

                                if q == u8('\\') then s.bump()
                                elif q == opened then break
                else
                    s.bump()
end read_hole

// A character literal: one character between two quotes, escapes included.
//
// It is a reader of its own rather than `read_quoted` with a length check, because what is wanted
// back is a `char` and because "exactly one" is the whole of its contract -- `''` and `'ab'` are
// both refused, and the second is refused at the character that should have been the closing quote.
read_char_literal(s: *Scanner, quote: u8) -> Result[char, LitError]
    val start = s.offset

    if !s.accept(quote) then return Err(NoQuote(one_at(start)))

    val c = s.peek() match
        None -> return Err(Unterminated(s.span_from(start)))
        Some(b) ->
            // `''` is a literal holding nothing, and the whole of it is what to underline. It is
            // `BadCodepoint` rather than `NoDigits` because the two render, and a reader told
            // "no digits" about a character literal is being answered a question they did not ask.
            if b == quote then return Err(BadCodepoint(Span(start, s.offset + 1)))

            if b == u8('\\') then
                read_escape(s) match
                    Err(e) -> return Err(e)
                    Ok(ch) -> ch
            else
                s.next_char() match
                    Some(ch) -> ch
                    None -> return Err(Unterminated(s.span_from(start)))

    if !s.accept(quote) then return Err(Unterminated(s.span_from(start)))

    Ok(c)
end read_char_literal

/** A quoted literal with **no escapes at all**, with the cursor on the opening quote: what is between
 * the quotes is the text, backslash included.
 *
 * `read_quoted` is the other half of this pair and decodes escapes; which of the two a quote means is
 * the grammar's business and not this file's. Nearly every language that has one form has the other
 * -- TOML's `'…'` beside its `"…"`, Rust's `r"…"`, Python's `r'…'`, PowerShell's single quotes -- and
 * the raw one is what a Windows path and a regular expression are written in.
 *
 * **A newline inside is allowed and is not this reader's decision**, exactly as it is not
 * `read_quoted`'s: a grammar that ends a string at the end of the line tests for one itself. What is
 * refused here is only the input running out.
 *
 * Nothing is copied unless it has to be: the text between the quotes is a slice of the input, and
 * the `string` is made from it once.
 */
read_raw(s: *Scanner, quote: u8) -> Result[string, LitError]
    val start = s.offset

    if !s.accept(quote) then return Err(NoQuote(one_at(start)))

    val from = s.offset

    loop
        s.peek() match
            None -> return Err(Unterminated(s.span_from(start)))
            Some(c) ->
                if c == quote then break

                s.bump()

    val text = from_utf8_unchecked(s.src[from..<s.offset])

    s.bump()
    Ok(text)
end read_raw

/** What a run of the delimiter character means inside a **fenced** literal -- one written between
 * three of the same character, as `"""…"""` and `'''…'''` are.
 *
 * **The rule that makes this worth a reader is that the delimiter may appear in the text right up
 * against the fence.** `"""he said """"` is `he said "`, because the last three of the four quotes
 * close it and the first belongs to the string. Every language with a fenced literal has this
 * problem and most implementations get it wrong in the same direction: they stop at the first three
 * they see, and a string ending in the quote character comes out one character short.
 */
enum Fence
    /** Fewer than three of it: ordinary text, this many. */
    Text(n: usize)

    /** The literal ends here, with `keep` of them belonging to its text. */
    Ends(keep: usize)

    /** Six or more, which is a closing fence with nothing to close it against. */
    TooMany
end Fence

// Two of the three variants carry a count, so equality is not the one a bare enum gets by rule.
// Worth having rather than incidental: a grammar written against this compares the answer, and a
// test that could not would have to take it apart.
impl Eq for Fence
    eq(self, rhs: Fence) -> bool = self match
        Text(a) -> rhs match
            Text(b) -> a == b
            _ -> false
        Ends(a) -> rhs match
            Ends(b) -> a == b
            _ -> false
        TooMany -> rhs match
            TooMany -> true
            _ -> false

impl Display for Fence
    display(self, out: *Writer, fmt: FormatSpec)
        val text = self match
            Text(n) -> s"Text($n)"
            Ends(keep) -> s"Ends($keep)"
            TooMany -> "TooMany"

        display_str(text, out, fmt)

/** The run of `q` at the cursor, read as a `Fence`. **Nothing is consumed** -- what to do about the
 * answer is the grammar's, and only it knows whether the text goes into a builder or is sliced.
 *
 *     fence_run(s, q) match
 *         Text(n) -> ...           // push n of them, then skip n
 *         Ends(keep) -> ...        // push keep of them, then skip keep + 3
 *         TooMany -> ...
 */
fence_run(s: *Scanner, q: u8) -> Fence
    var run: usize = 0

    loop
        if s.peek_at(run) == Some(q) then run += 1 else break

    if run < 3 then Text(run) elif run > 5 then TooMany else Ends(run - 3)
