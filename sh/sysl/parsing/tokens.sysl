module sh.sysl.parsing

import sysl.buf.{Buf, buf}

// A value and where it came from.
//
// **Nearly everything a parser passes around wants to be one of these.** A token without its span
// cannot be reported about; a syntax node without its span makes every later pass -- a type checker,
// a formatter, a language server -- go back to the text and guess. Carrying the pair costs two
// integers and removes the guessing.
struct Spanned[T]
    value: T
    span: Span

    // The same span over a different value, which is what a parser does when it folds a token into
    // a node: the position survives and the thing at it changes.
    map_to[U](self, v: U) -> Spanned[U] = Spanned(v, self.span)
end Spanned

// Two of them are equal when both halves are, which is what a test comparing a token to what it
// should have been asks -- and it is a written block rather than something the compiler hands out,
// because a `Spanned` of a type with no equality has none either.
impl[T: Eq] Eq for Spanned[T]
    eq(self, rhs: Spanned[T]) -> bool = self.span == rhs.span && self.value == rhs.value

// Rendered as the value it holds and the span it came from, which is what a test failure and a
// dump of a token stream both want to read.
impl[T: Display] Display for Spanned[T]
    display(self, out: *Writer, fmt: FormatSpec) = display_str(s"${self.value} @${self.span}", out, fmt)

// A cursor over tokens that have already been lexed.
//
// **A grammar has two cursors and they are not the same shape.** `Scanner` walks bytes, where
// lookahead is a byte and backtracking is cheap; this walks whatever the lexer produced, where
// lookahead is a token and the interesting question is what came *before* -- the span of the token
// just consumed, which is where "expected a `)` after this" points.
//
// It exists because the lex-then-parse split is the one nearly every hand-written front end takes:
// the scanner tier turns bytes into a `Buf[Spanned[T]]`, and everything above it never looks at a
// byte again.
struct Tokens[T]
    items: Buf[Spanned[T]]
    at: usize

    len(self) -> usize = self.items.len()

    at_end(self) -> bool = self.at >= self.items.len()

    // Where the cursor is, as an index into the token list.
    position -> usize = self.at

    // The token at the cursor, without taking it.
    peek(self) -> Option[Spanned[T]] = self.peek_at(0)

    // The token `n` further on. Two is enough for nearly every grammar and the parameter is there
    // for the ones where it is not.
    peek_at(self, n: usize) -> Option[Spanned[T]]
        val i = self.at + n

        if i >= self.items.len() then None else Some(self.items.at(i))

    // The token at the cursor, taken.
    advance(*self) -> Option[Spanned[T]]
        if self.at >= self.items.len() then return None

        val t = self.items.at(self.at)

        self.at += 1
        Some(t)
    end advance

    // The token at the cursor, taken only if it answers the predicate.
    //
    // The predicate takes the value rather than the `Spanned`, because what a grammar asks is
    // "is this a comma", and having to write `(t) -> t.value == Comma` at every call is the noise
    // this exists to remove.
    accept_if(*self, p: T -> bool) -> Option[Spanned[T]]
        self.peek() match
            Some(t) ->
                if p(t.value) then
                    self.at += 1
                    Some(t)
                else
                    None
            None -> None
    end accept_if

    // Where the cursor is, in the input's own terms: the span of the token it is on, or an empty
    // span at the end of the last one where there are no tokens left.
    //
    // **The second half is what makes an at-the-end message point somewhere.** A parser that runs
    // out of tokens has nothing to point at, and pointing at the last token it *did* see is what
    // reads as "this is where you stopped".
    here(self) -> Span
        self.peek() match
            Some(t) -> t.span
            None ->
                if self.items.is_empty() then
                    point(0)
                else
                    point(self.items.at(self.items.len() - 1).span.end)
    end here

    // The span of the token just consumed, which is where "expected something after this" points.
    previous(self) -> Span
        if self.at == 0 then return point(0)

        self.items.at(self.at - 1).span
    end previous

    // The span from a mark to the cursor, which is a whole construct's extent: mark before parsing
    // it, ask afterwards.
    span_from(self, m: usize) -> Span
        if self.items.is_empty() then return point(0)

        val from = if m >= self.items.len() then self.items.len() - 1 else m
        val to = if self.at == 0 then 0 else self.at - 1
        val last = if to >= self.items.len() then self.items.len() - 1 else to

        self.items.at(from).span.to(self.items.at(last).span)
    end span_from

    mark(self) -> usize = self.at

    reset(*self, m: usize)
        self.at = if m > self.items.len() then self.items.len() else m

    // One more token on the end, which is what a lexer's loop does.
    push(*self, value: T, span: Span)
        self.items.push(Spanned(value, span))

    // The token just taken, value and all.
    //
    // **`previous` answers where it was and this answers what it was**, and a grammar needs both.
    // The one that is easy to leave out is this: a block-structured language asks "did a block just
    // close?" to decide whether a statement has ended, and without it the only way to find out is to
    // read `items` at `position - 1` by hand -- which is reaching through the struct to do something
    // the struct should offer.
    looked_back(self) -> Option[Spanned[T]]
        if self.at == 0 then return None

        Some(self.items.at(self.at - 1))
    end looked_back
end Tokens


// Where a bracketed list of nothing but bare names ends, if that is what stands at `from`.
//
// **A LOOKAHEAD, for the one thing a keyword-free grammar cannot decide any other way.** A grammar
// that tells a definition from a call by what FOLLOWS the head -- sysl's own shape, and slate's --
// has to step over the head first, and a type parameter list is part of it: `first[T](xs)` is a
// definition and `handlers[0](x)` is an index followed by a call, and the two are identical up to
// the `]`. What separates them is that only one holds nothing but names.
//
// **`Some(i)` is the index just past the closing bracket**, so a caller carries on scanning from
// there; `None` is "this is not that", which covers three cases a caller wants to treat the same
// way: no opening bracket at all, something other than a name inside, and text that runs out first.
//
// **An empty pair answers `None`**, a list of no names not being a list of names. A grammar that
// means something by `[]` is asking a different question and can look for the two tokens itself.
//
// The tokens are parameters because they are the *grammar's*: this package knows nothing about which
// of your tokens is a bracket. Pass them in the order they appear -- `names_end(t, i, LBracket,
// RBracket, Comma, Ident)`.
names_end[T: Eq](toks: Tokens[T], from: usize, open: T, close: T, sep: T, name: T) -> Option[usize]
    if kind_at(toks, from) != Some(open) then return None

    var i = from + 1

    loop
        if kind_at(toks, i) != Some(name) then return None

        i += 1

        if kind_at(toks, i) != Some(sep) then break

        i += 1

    if kind_at(toks, i) != Some(close) then return None

    Some(i + 1)
end names_end

// The kind of the token at an absolute index, which is what a lookahead over the list asks.
//
// **An index rather than an offset from the cursor**, because a scan like `names_end` walks its own
// way along and has no cursor of its own to be relative to.
kind_at[T](toks: Tokens[T], i: usize) -> Option[T] =
    if i >= toks.items.len() then None else Some(toks.items.at(i).value)

// An empty token list, to be filled by a lexer and then read by a parser.
tokens[T]() -> Tokens[T] = Tokens(buf(), 0)

// A token list over what a lexer has already gathered.
tokens_of[T](items: Buf[Spanned[T]]) -> Tokens[T] = Tokens(items, 0)
