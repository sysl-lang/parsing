module sh.sysl.parsing
@tests

// -- read_ident_wide ----------------------------------------------------------------------------

private val name_start: ByteSet = byte_set_where(is_ident_start)
private val name_cont: ByteSet = byte_set_where(is_ident_cont)

// U+00B7 (a middle dot) may continue a name but not start one; U+2603 (a snowman) is in neither.
private wide_start(c: u32) -> bool = c >= 0x80 && c != 0xB7 && c != 0x2603

private wide_cont(c: u32) -> bool = c >= 0x80 && c != 0x2603

private wide_name(text: string) -> (Option[Span], usize)
    var s = scanner_of(text)
    val r = s.read_ident_wide(name_start, name_cont, wide_start, wide_cont)

    (r, s.offset)
end wide_name

@test
wide_names_ascii_only()
    assert_eq(wide_name("ab_9 x"), (Some(Span(0, 4)), 4))
    assert_eq(wide_name("9a"), (None, 0))

@test
wide_names_multi_byte()
    assert_eq(wide_name("aé"), (Some(Span(0, 3)), 3))
    assert_eq(wide_name("a\u{20AC}b"), (Some(Span(0, 5)), 5))
    assert_eq(wide_name("a\u{1F600}b c"), (Some(Span(0, 6)), 6))

@test
wide_names_may_start_wide()
    assert_eq(wide_name("éa+"), (Some(Span(0, 3)), 3))
    assert_eq(wide_name("\u{1F600}"), (Some(Span(0, 4)), 4))
    assert_eq(wide_name("日本語 x"), (Some(Span(0, 9)), 9))

@test
wide_names_stop_at_a_refused_character()
    // The snowman is refused mid-name and the name ends before it, unconsumed.
    assert_eq(wide_name("ab\u{2603}c"), (Some(Span(0, 2)), 2))
    // Refused as the first character: nothing is read and nothing moves.
    assert_eq(wide_name("\u{2603}a"), (None, 0))
    // The middle dot continues a name but cannot start one.
    assert_eq(wide_name("a\u{B7}b"), (Some(Span(0, 4)), 4))
    assert_eq(wide_name("\u{B7}a"), (None, 0))
    // An ASCII byte the set refuses stops it too.
    assert_eq(wide_name("aé-b"), (Some(Span(0, 3)), 3))

@test
wide_names_stop_at_malformed_utf8()
    val mid: [4]u8 = [u8('a'), 0xFF, u8('b'), 0]
    var s = scanner(mid[0..<3])

    assert_eq(s.read_ident_wide(name_start, name_cont, wide_start, wide_cont), Some(Span(0, 1)))
    assert_eq(s.offset, 1)

    // A truncated multi-byte character at the end is malformed as well.
    val cut: [3]u8 = [u8('a'), 0xE2, 0x82]
    var t = scanner(cut[0..<3])

    assert_eq(t.read_ident_wide(name_start, name_cont, wide_start, wide_cont), Some(Span(0, 1)))

    // Malformed as the first byte: no name.
    val lead: [2]u8 = [0xFF, u8('a')]
    var u = scanner(lead[0..<2])

    assert_eq(u.read_ident_wide(name_start, name_cont, wide_start, wide_cont), None)
    assert_eq(u.offset, 0)

@test
wide_names_accept_a_real_replacement_character()
    // U+FFFD written out is well-formed text, and the predicate decides about it.
    assert_eq(wide_name("a\u{FFFD}b"), (Some(Span(0, 5)), 5))

@test
wide_names_empty_and_at_end_of_input()
    assert_eq(wide_name(""), (None, 0))
    assert_eq(wide_name("é"), (Some(Span(0, 2)), 2))
    assert_eq(wide_name("abc"), (Some(Span(0, 3)), 3))

// -- plain digits ---------------------------------------------------------------------------------

private plain(text: string, base: int) -> (Result[ulong, LitError], usize)
    var s = scanner_of(text)
    val r = read_plain_digits(&s, base)

    (r, s.offset)
end plain

@test
plain_digits_in_every_base()
    assert_eq(plain("42", 10).0.unwrap(), 42)
    assert_eq(plain("ff", 16).0.unwrap(), 255)
    assert_eq(plain("17", 8).0.unwrap(), 15)
    assert_eq(plain("101", 2).0.unwrap(), 5)

@test
plain_digits_stop_at_an_underscore()
    val r = plain("1_000", 10)

    assert_eq(r.0.unwrap(), 1)
    assert_eq(r.1, 1)
    assert_eq(plain("ab_c", 16).1, 2)

@test
plain_digits_with_a_leading_underscore_are_no_digits()
    val r = plain("_1", 10)

    assert(r.0.is_err(), "no digits before the underscore")
    assert_eq(r.1, 0)

@test
plain_digits_empty_run_is_no_digits()
    assert(plain("", 10).0.is_err(), "empty input")
    assert(plain("x", 10).0.is_err(), "not a digit")

@test
plain_digits_report_overflow()
    assert(plain("18446744073709551616", 10).0.is_err(), "one past ulong")
    assert_eq(plain("18446744073709551615", 10).0.unwrap(), 18446744073709551615)

@test
read_digits_still_accepts_separators()
    var s = scanner_of("1_000")

    assert_eq(read_digits(&s, 10).unwrap(), 1000)
    assert_eq(s.offset, 5)

    var t = scanner_of("1_")

    assert(read_digits(&t, 10).is_err(), "a trailing separator is still refused")

// -- plain numbers --------------------------------------------------------------------------------

private plain_number(text: string) -> (Number, usize)
    var s = scanner_of(text)
    val n = read_plain_number(&s).unwrap()

    (n, s.offset)
end plain_number

@test
plain_numbers_stop_at_an_underscore()
    val a = plain_number("1_000")

    assert_eq(a.0, Int(1))
    assert_eq(a.1, 1)

    val b = plain_number("1.5_5")

    assert_eq(b.0, Real(1.5))
    assert_eq(b.1, 3)

    val c = plain_number("2e1_0")

    assert_eq(c.0, Real(20.0))
    assert_eq(c.1, 3)

@test
plain_numbers_read_what_read_number_reads()
    assert_eq(plain_number("42").0, Int(42))
    assert_eq(plain_number("0xFF").0, Int(255))
    assert_eq(plain_number("0.25").0, Real(0.25))
    assert_eq(plain_number("1e3").0, Real(1000.0))

@test
read_number_still_accepts_separators()
    var s = scanner_of("1_000.5")

    assert_eq(read_number(&s).unwrap(), Real(1000.5))
    assert_eq(s.offset, 7)
