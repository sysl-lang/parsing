module sh.sysl.parsing
@tests

// What this package claims, run by `sysl test .`.

// -- source -----------------------------------------------------------------------------------

@test
an_empty_input_has_one_line()
    val s = source_of("<empty>", "")

    assert_eq(s.line_count(), 1)
    assert_eq(s.locate(0), Loc(1, 1))
end an_empty_input_has_one_line

@test
lines_are_counted_from_one()
    val s = source_of("t", "ab\ncd\n\nef")

    assert_eq(s.line_count(), 4)
    assert_eq(s.locate(0), Loc(1, 1))
    assert_eq(s.locate(1), Loc(1, 2))
    assert_eq(s.locate(3), Loc(2, 1))
    assert_eq(s.locate(6), Loc(3, 1))
    assert_eq(s.locate(7), Loc(4, 1))
end lines_are_counted_from_one

@test
an_offset_past_the_end_lands_after_the_last_character()
    val s = source_of("t", "ab")

    assert_eq(s.locate(2), Loc(1, 3))
    assert_eq(s.locate(99), Loc(1, 3))
end an_offset_past_the_end_lands_after_the_last_character

@test
a_column_counts_characters_and_not_bytes()
    val s = source_of("t", "héllo")

    assert_eq(s.locate(1), Loc(1, 2))
    assert_eq(s.locate(3), Loc(1, 3))
end a_column_counts_characters_and_not_bytes

// The end of an input that ends in a newline is the start of an empty line, and a diagnostic about
// something missing at the end of the file has to have somewhere to point.
@test
a_trailing_newline_opens_an_empty_last_line()
    val s = source_of("t", "ab\n")

    assert_eq(s.line_count(), 2)
    assert_eq(s.locate(3), Loc(2, 1))
    assert(s.line_span(2).is_empty(), "the last line is empty")
end a_trailing_newline_opens_an_empty_last_line

@test
a_line_is_handed_back_without_its_terminator()
    val s = source_of("t", "ab\r\ncd\n")

    assert(sysl.slices.equal(s.line_text(1), "ab".bytes), "the first line")
    assert(sysl.slices.equal(s.line_text(2), "cd".bytes), "the second line")
end a_line_is_handed_back_without_its_terminator

@test
a_span_covers_both_of_its_children()
    assert_eq(Span(2, 4).to(Span(7, 9)), Span(2, 9))
    assert_eq(Span(7, 9).to(Span(2, 4)), Span(2, 9))
    assert(point(3).is_empty(), "a point spans nothing")
end a_span_covers_both_of_its_children

// -- scan -------------------------------------------------------------------------------------

@test
a_scanner_walks_bytes()
    var s = scanner_of("ab")

    assert_eq(s.peek(), Some(u8('a')))
    assert_eq(s.peek_at(1), Some(u8('b')))
    assert_eq(s.peek_at(2), None)
    assert_eq(s.next(), Some(u8('a')))
    assert_eq(s.next(), Some(u8('b')))
    assert_eq(s.next(), None)
    assert(s.at_end(), "the end")
end a_scanner_walks_bytes

@test
a_cursor_saturates_at_the_end()
    var s = scanner_of("a")

    s.bump()
    s.bump()
    s.bump()
    assert_eq(s.offset, 1)
    assert_eq(s.remaining(), 0)
end a_cursor_saturates_at_the_end

@test
accepting_moves_only_on_a_match()
    var s = scanner_of("-1")

    assert(!s.accept(u8('+')), "no plus")
    assert_eq(s.offset, 0)
    assert(s.accept(u8('-')), "a minus")
    assert_eq(s.offset, 1)
end accepting_moves_only_on_a_match

@test
a_run_is_all_or_nothing()
    var s = scanner_of("-->x")

    assert(!s.accept_seq("--!".bytes), "a partial match moves nothing")
    assert_eq(s.offset, 0)
    assert(s.starts_with("-->".bytes), "starts_with")
    assert(s.accept_seq("-->".bytes), "the whole run")
    assert_eq(s.offset, 3)
end a_run_is_all_or_nothing

@test
accepting_from_a_set_and_by_a_predicate()
    var s = scanner_of("12+")

    assert(s.accept_if(digit), "a digit by a named predicate")
    assert(s.accept_if((c) -> c >= u8('0') && c <= u8('9')), "a digit by a closure")
    assert(!s.accept_any("*/".bytes), "not in the set")
    assert(s.accept_any("+-".bytes), "in the set")
    assert(s.at_end(), "all of it")
end accepting_from_a_set_and_by_a_predicate

@test
runs_report_how_far_they_went()
    var s = scanner_of("123abc")

    assert_eq(s.accept_while(digit), 3)
    assert_eq(s.accept_while(digit), 0)
    assert_eq(s.accept_until(digit), 3)
    assert(s.at_end(), "the end")
end runs_report_how_far_they_went

@test
skip_until_stops_on_the_byte_it_found()
    var s = scanner_of("bad tokens , then")

    assert_eq(s.skip_until(",;".bytes), 11)
    assert_eq(s.peek(), Some(u8(',')))
end skip_until_stops_on_the_byte_it_found

@test
skip_until_stops_at_the_end_when_nothing_is_there()
    var s = scanner_of("nothing here")

    assert_eq(s.skip_until(",;".bytes), 12)
    assert(s.at_end(), "the end")
end skip_until_stops_at_the_end_when_nothing_is_there

@test
a_mark_takes_the_token_and_puts_the_cursor_back()
    var s = scanner_of("let x")
    val m = s.mark()

    assert_eq(s.accept_while(alpha), 3)
    assert_eq(s.span_from(m), Span(0, 3))
    assert(sysl.slices.equal(s.text_from(m), "let".bytes), "the token's own text")

    s.reset(m)
    assert_eq(s.offset, 0)
    assert_eq(s.here(), Span(0, 0))
end a_mark_takes_the_token_and_puts_the_cursor_back

@test
characters_are_read_whole()
    var s = scanner_of("héllo")

    assert_eq(s.next_char(), Some('h'))
    assert_eq(s.peek_char(), Some('é'))
    assert_eq(s.offset, 1)
    assert(s.accept_char('é'), "the accented character")
    assert_eq(s.offset, 3)
    assert(!s.accept_char('x'), "not that one")
    assert_eq(s.offset, 3)
end characters_are_read_whole

private digit(c: u8) -> bool = c >= u8('0') && c <= u8('9')

private alpha(c: u8) -> bool = (c >= u8('a') && c <= u8('z')) || (c >= u8('A') && c <= u8('Z'))

// -- literal ----------------------------------------------------------------------------------

private int_of(text: string) -> Result[ulong, LitError]
    var s = scanner_of(text)

    read_integer(&s)
end int_of

@test
integers_in_every_base()
    assert_eq(int_of("0").unwrap(), 0)
    assert_eq(int_of("42").unwrap(), 42)
    assert_eq(int_of("0xFF").unwrap(), 255)
    assert_eq(int_of("0XfF").unwrap(), 255)
    assert_eq(int_of("0o17").unwrap(), 15)
    assert_eq(int_of("0b1011").unwrap(), 11)
    assert_eq(int_of("007").unwrap(), 7)
end integers_in_every_base

@test
underscores_separate_and_do_not_lead_or_trail()
    assert_eq(int_of("1_000_000").unwrap(), 1000000)
    assert(int_of("_1").is_err(), "a leading underscore")
    assert(int_of("1_").is_err(), "a trailing underscore")
    assert(int_of("1__0").is_err(), "a doubled underscore")
end underscores_separate_and_do_not_lead_or_trail

@test
a_prefix_with_no_digits_is_refused()
    assert(int_of("0x").is_err(), "0x alone")
    assert(int_of("0b").is_err(), "0b alone")
end a_prefix_with_no_digits_is_refused

@test
the_largest_value_fits_and_the_next_one_does_not()
    assert_eq(int_of("18446744073709551615").unwrap(), 18446744073709551615)
    assert(int_of("18446744073709551616").is_err(), "one past the top")
    assert(int_of("0xFFFFFFFFFFFFFFFFF").is_err(), "seventeen hex digits")
end the_largest_value_fits_and_the_next_one_does_not

// An overflowing literal consumes all of its digits, so the grammar resumes after the number rather
// than in the middle of it and reports one error instead of two.
@test
an_overflow_still_consumes_the_whole_number()
    var s = scanner_of("99999999999999999999999 +")

    assert(read_integer(&s).is_err(), "too large")
    assert_eq(s.peek(), Some(u8(' ')))
end an_overflow_still_consumes_the_whole_number

private num_of(text: string) -> Result[Number, LitError]
    var s = scanner_of(text)

    read_number(&s)
end num_of

@test
a_number_is_an_integer_until_something_says_otherwise()
    num_of("12").unwrap() match
        Int(v) -> assert_eq(v, 12)
        Real(_) -> assert(false, "12 is an integer")

    num_of("1.5").unwrap() match
        Int(_) -> assert(false, "1.5 is not an integer")
        Real(x) -> assert_eq(x, 1.5)

    num_of("1e3").unwrap() match
        Int(_) -> assert(false, "1e3 is not an integer")
        Real(x) -> assert_eq(x, 1000.0)

    num_of("2E-2").unwrap() match
        Int(_) -> assert(false, "2E-2 is not an integer")
        Real(x) -> assert_eq(x, 0.02)

    num_of("1_000.5").unwrap() match
        Int(_) -> assert(false, "not an integer")
        Real(x) -> assert_eq(x, 1000.5)
end a_number_is_an_integer_until_something_says_otherwise

// The dot belongs to the number only when a digit follows it, which is what keeps `0..<n` and
// `1.max()` readable without a space.
@test
a_dot_with_no_digit_after_it_is_not_part_of_the_number()
    var s = scanner_of("0..<8")

    s.offset

    read_number(&s).unwrap() match
        Int(v) -> assert_eq(v, 0)
        Real(_) -> assert(false, "not a float")

    assert_eq(s.offset, 1)

    var t = scanner_of("1.max()")

    read_number(&t).unwrap() match
        Int(v) -> assert_eq(v, 1)
        Real(_) -> assert(false, "not a float")

    assert_eq(t.offset, 1)
end a_dot_with_no_digit_after_it_is_not_part_of_the_number

@test
a_prefixed_literal_is_never_a_float()
    var s = scanner_of("0x1.8")

    read_number(&s).unwrap() match
        Int(v) -> assert_eq(v, 1)
        Real(_) -> assert(false, "no hexadecimal floats")

    // The dot and the digit after it are left where they are: C's `0x1.8p3` is a hexadecimal float
    // and this is not a reader of one, so what the grammar gets back is the integer and a cursor
    // pointing at something it has to decide about itself.
    assert_eq(s.offset, 3)
end a_prefixed_literal_is_never_a_float

private quoted(text: string) -> Result[string, LitError]
    var s = scanner_of(text)

    read_quoted(&s, u8('"'))
end quoted

@test
escapes_decode()
    assert_eq(quoted("\"a\\nb\"").unwrap(), "a\nb")
    assert_eq(quoted("\"\\t\\r\\\\\\\"\"").unwrap(), "\t\r\\\"")
    assert_eq(quoted("\"\\x41\"").unwrap(), "A")
    assert_eq(quoted("\"\\u0041\"").unwrap(), "A")
    assert_eq(quoted("\"\\u{1F600}\"").unwrap(), "😀")
end escapes_decode

// JSON writes an astral character as a UTF-16 pair and UTF-8 has no such thing, so the pair is put
// back together here or the text comes out as two errors.
@test
a_surrogate_pair_is_one_character()
    assert_eq(quoted("\"\\ud83d\\ude00\"").unwrap(), "😀")
    assert(quoted("\"\\ud83d\"").is_err(), "a high surrogate alone")
    assert(quoted("\"\\ude00\"").is_err(), "a low surrogate alone")
    assert(quoted("\"\\ud83dx\"").is_err(), "a pair that is not one")
end a_surrogate_pair_is_one_character

@test
a_quote_that_never_closes_is_refused()
    assert(quoted("\"abc").is_err(), "no closing quote")
    assert(quoted("\"abc\\").is_err(), "ends inside an escape")
    assert(quoted("abc").is_err(), "no opening quote")
end a_quote_that_never_closes_is_refused

@test
a_bad_escape_names_the_backslash()
    var s = scanner_of("\"a\\qb\"")

    read_quoted(&s, u8('"')) match
        Ok(_) -> assert(false, "q is not an escape")
        Err(e) -> assert_eq(where(e), Span(2, 2))
end a_bad_escape_names_the_backslash

@test
text_outside_the_escapes_is_copied_whole()
    assert_eq(quoted("\"héllo wörld\"").unwrap(), "héllo wörld")
    assert_eq(quoted("\"\"").unwrap(), "")
end text_outside_the_escapes_is_copied_whole

@test
a_character_literal_holds_exactly_one()
    var s = scanner_of("'a'")

    assert_eq(read_char_literal(&s, u8('\'')).unwrap(), 'a')

    var t = scanner_of("'\\n'")

    assert_eq(read_char_literal(&t, u8('\'')).unwrap(), '\n')

    var u = scanner_of("'é'")

    assert_eq(read_char_literal(&u, u8('\'')).unwrap(), 'é')

    var v = scanner_of("''")

    assert(read_char_literal(&v, u8('\'')).is_err(), "nothing between the quotes")

    var w = scanner_of("'ab'")

    assert(read_char_literal(&w, u8('\'')).is_err(), "two characters")
end a_character_literal_holds_exactly_one

// -- classes ----------------------------------------------------------------------------------

@test
a_byte_set_holds_what_was_put_in_it()
    val s = byte_set_of("+-*/")

    assert(s.has(u8('+')), "plus")
    assert(s.has(u8('/')), "slash")
    assert(!s.has(u8('x')), "not x")
    assert_eq(s.size(), 4)
    assert(empty_set().is_empty(), "nothing in the empty set")
end a_byte_set_holds_what_was_put_in_it

@test
a_set_covers_every_byte_and_not_only_the_ascii_ones()
    val s = byte_set_where(is_non_ascii)

    assert(s.has(255), "the last byte")
    assert(s.has(128), "the first non-ascii one")
    assert(!s.has(127), "not the last ascii one")
    assert_eq(s.size(), 128)
end a_set_covers_every_byte_and_not_only_the_ascii_ones

@test
sets_combine()
    val letters = byte_range(u8('a'), u8('z'))
    val digits = byte_set_where(is_digit)
    val both = letters.union(digits)

    assert_eq(letters.size(), 26)
    assert_eq(both.size(), 36)
    assert_eq(both.intersect(digits).size(), 10)
    assert_eq(both.without(digits).size(), 26)
    assert_eq(letters.invert().size(), 230)
    assert(!letters.invert().has(u8('a')), "the complement")
end sets_combine

@test
identifier_classes_are_the_c_family_ones()
    assert(is_ident_start(u8('_')), "underscore starts one")
    assert(!is_ident_start(u8('9')), "a digit does not")
    assert(is_ident_cont(u8('9')), "a digit continues one")
end identifier_classes_are_the_c_family_ones

// -- scanner helpers --------------------------------------------------------------------------

@test
a_set_drives_the_cursor()
    val ident = byte_set_where(is_ident_cont)
    var s = scanner_of("name_1 rest")

    assert_eq(s.accept_while_set(ident), 6)
    assert(!s.accept_set(ident), "a space is not in it")
    assert_eq(s.skip_until_set(byte_set_of("t")), 4)
end a_set_drives_the_cursor

@test
looking_ahead_moves_nothing()
    var s = scanner_of("===x")

    assert_eq(s.peek_while((c) -> c == u8('=')), 3)
    assert_eq(s.offset, 0)
    assert_eq(s.find(u8('x')), Some(3))
    assert_eq(s.find(u8('q')), None)
    assert_eq(s.offset, 0)
end looking_ahead_moves_nothing

@test
blanks_stop_at_a_newline_and_space_does_not()
    var s = scanner_of("  \n  x")

    assert_eq(s.skip_blanks(), 2)
    assert(s.at_line_end(), "on the newline")

    var t = scanner_of("  \n  x")

    assert_eq(t.skip_space(), 5)
    assert_eq(t.peek(), Some(u8('x')))
end blanks_stop_at_a_newline_and_space_does_not

// A file written on either kind of machine has to look the same to a grammar that counts lines.
@test
crlf_is_one_line_ending()
    var s = scanner_of("a\r\nb\nc")
    var lines = 0

    while !s.at_end()
        s.skip_to_line_end()

        if s.accept_newline() then lines += 1

    assert_eq(lines, 2)
end crlf_is_one_line_ending

@test
comments_run_to_the_end_of_the_line()
    var s = scanner_of("// gone\nkept")

    assert(s.skip_line_comment("//".bytes), "a comment")
    assert(s.at_line_end(), "stopped on the newline")
    assert(!s.skip_line_comment("//".bytes), "not a comment")

    s.accept_newline()
    assert_eq(s.peek(), Some(u8('k')))
end comments_run_to_the_end_of_the_line

@test
block_comments_nest_when_the_language_says_they_do()
    var s = scanner_of("/* a /* b */ c */x")

    assert_eq(s.skip_block_comment("/*".bytes, "*/".bytes, true), Ok(true))
    assert_eq(s.peek(), Some(u8('x')))

    var t = scanner_of("/* a /* b */ c */x")

    assert_eq(t.skip_block_comment("/*".bytes, "*/".bytes, false), Ok(true))
    assert_eq(t.peek(), Some(u8(' ')))

    var u = scanner_of("plain")

    assert_eq(u.skip_block_comment("/*".bytes, "*/".bytes, false), Ok(false))
    assert_eq(u.offset, 0)
end block_comments_nest_when_the_language_says_they_do

@test
a_comment_that_never_closes_reports_where_it_started()
    var s = scanner_of("x /* forever")

    s.skip(2)
    assert_eq(s.skip_block_comment("/*".bytes, "*/".bytes, false), Err(Span(2, 12)))
end a_comment_that_never_closes_reports_where_it_started

// The check every hand-written lexer forgets once: a keyword that swallows the front of a longer
// identifier.
@test
a_keyword_is_only_a_keyword_when_the_word_ends()
    var s = scanner_of("ifx")

    assert(!s.accept_word("if".bytes, is_ident_cont), "ifx is not if")
    assert_eq(s.offset, 0)

    var t = scanner_of("if (")

    assert(t.accept_word("if".bytes, is_ident_cont), "if is")
    assert_eq(t.offset, 2)

    var u = scanner_of("if")

    assert(u.accept_word("if".bytes, is_ident_cont), "at the end of the input")
end a_keyword_is_only_a_keyword_when_the_word_ends

@test
identifiers_are_read_as_spans()
    var s = scanner_of("_x9 +")

    assert_eq(s.read_ident(is_ident_start, is_ident_cont), Some(Span(0, 3)))
    assert_eq(s.read_ident(is_ident_start, is_ident_cont), None)
    assert_eq(s.offset, 3)
end identifiers_are_read_as_spans

@test
brackets_are_counted_past()
    var s = scanner_of("(a(b)c)rest")

    assert_eq(s.skip_balanced(u8('('), u8(')')), Ok(Span(0, 7)))
    assert_eq(s.peek(), Some(u8('r')))

    var t = scanner_of("(a(b)c")

    assert_eq(t.skip_balanced(u8('('), u8(')')), Err(Span(0, 6)))
end brackets_are_counted_past

// -- diag -------------------------------------------------------------------------------------

// Compare, and say what the difference was. A rendering's whole contract is its exact text, so a
// failure that only said `false` would leave the reader diffing by eye.
private same(got: string, want: string, what: string, file: string = __FILE__, line: long = __LINE__)
    if got != want
        print("\n")
        print(what)
        print("\nwanted:\n")
        print(want)
        print("got:\n")
        print(got)

    assert(got == want, what, file, line)
end same

private val json: string = "{\n  \"a\": 1,\n  \"b\": ,\n}\n"

@test
a_diagnostic_renders_the_way_the_compiler_does()
    val src = source_of("config.json", json)
    val d = expected(Span(19, 20), "a value", found_at(src, Span(19, 20)))
        .with_note("a value is a number, a string, `true`, `false`, `null`, an array or an object")

    same(d.render(src),
        "error: expected a value\n" +
        " --> config.json:3:8\n" +
        "  |\n" +
        "3 |   \"b\": ,\n" +
        "  |        ^ found `,`\n" +
        "  |\n" +
        "  = note: a value is a number, a string, `true`, `false`, `null`, an array or an object\n",
        "the whole rendering")
end a_diagnostic_renders_the_way_the_compiler_does

@test
a_caret_is_as_wide_as_its_span()
    val src = source_of("t", "let xyz = 1")

    same(error(Span(4, 7), "unknown name").render(src),
        "error: unknown name\n" +
        " --> t:1:5\n" +
        "  |\n" +
        "1 | let xyz = 1\n" +
        "  |     ^^^\n",
        "three carets")
end a_caret_is_as_wide_as_its_span

// A span of nothing is something *missing*, and a message pointing at zero characters points at
// nothing -- so it still gets one caret.
@test
a_point_still_gets_a_caret()
    val src = source_of("t", "f(1")

    same(error(point(3), "unclosed bracket").render(src),
        "error: unclosed bracket\n" +
        " --> t:1:4\n" +
        "  |\n" +
        "1 | f(1\n" +
        "  |    ^\n",
        "one caret past the end")
end a_point_still_gets_a_caret

// The caret is placed by display width rather than by byte count, so a line with wide characters in
// it still points at the right thing.
@test
a_caret_lands_under_wide_characters()
    val src = source_of("t", "val 日本 = x")

    same(error(Span(11, 12), "here").render(src),
        "error: here\n" +
        " --> t:1:8\n" +
        "  |\n" +
        "1 | val 日本 = x\n" +
        "  |          ^\n",
        "past two wide characters")
end a_caret_lands_under_wide_characters

// What a multi-line span usually means is an unterminated something, and the useful place to point
// is where it started -- so the caret stops at the end of the first line.
@test
a_span_over_several_lines_is_drawn_against_its_first()
    val src = source_of("t", "\"abc\ndef\n")

    same(error(Span(0, 9), "unterminated string").render(src),
        "error: unterminated string\n" +
        " --> t:1:1\n" +
        "  |\n" +
        "1 | \"abc\n" +
        "  | ^^^^\n",
        "capped at the line")
end a_span_over_several_lines_is_drawn_against_its_first

@test
the_gutter_is_as_wide_as_the_line_number()
    var text = ""

    for _ in 0..<9
        text = text + "x\n"

    text = text + "boom\n"

    val src = source_of("t", text)

    same(error(Span(18, 22), "here").render(src),
        "error: here\n" +
        "  --> t:10:1\n" +
        "   |\n" +
        "10 | boom\n" +
        "   | ^^^^\n",
        "a two-digit gutter")
end the_gutter_is_as_wide_as_the_line_number

@test
a_report_sorts_by_position_and_stops_at_its_limit()
    val src = source_of("t", "abcdef")
    var r = report()

    r.limit = 2

    r.add(error(Span(4, 5), "third"))
    r.add(error(Span(0, 1), "first"))
    r.add(error(Span(2, 3), "second"))

    assert_eq(r.len(), 3)
    assert(r.has_errors(), "errors")
    same(r.render(src),
        "error: first\n" +
        " --> t:1:1\n" +
        "  |\n" +
        "1 | abcdef\n" +
        "  | ^\n" +
        "\n" +
        "error: second\n" +
        " --> t:1:3\n" +
        "  |\n" +
        "1 | abcdef\n" +
        "  |   ^\n" +
        "\n" +
        "showing the first 2 of 3\n",
        "sorted and truncated")
end a_report_sorts_by_position_and_stops_at_its_limit

@test
a_report_of_warnings_alone_is_not_a_failure()
    var r = report()

    r.add(warning(point(0), "careful"))
    assert(!r.has_errors(), "no errors")
    assert(!r.is_empty(), "not empty")
    assert(report().is_empty(), "a fresh report")
end a_report_of_warnings_alone_is_not_a_failure

@test
quoting_the_input_cannot_rearrange_a_message()
    assert_eq(escape_text("a\nb\tc".bytes), "a\\nb\\tc")
    assert_eq(escape_text("\u{1}".bytes), "\\x01")
    assert_eq(escape_text("héllo".bytes), "héllo")
end quoting_the_input_cannot_rearrange_a_message

@test
what_was_found_at_the_end_of_the_input_is_named()
    val src = source_of("t", "ab")

    assert_eq(found_at(src, point(2)), "the end of the input")
    assert_eq(found_at(src, Span(0, 1)), "`a`")
    assert_eq(found_at(src, point(0)), "`a`")
end what_was_found_at_the_end_of_the_input_is_named
