module sh.sysl.parsing
@tests

import sysl.buf.{Buf, buf}

// What this package claims, run by `sysl test .`.

// -- source -----------------------------------------------------------------------------------

@test
an_empty_input_has_one_line()
    val s = source_of("<empty>", "")

    assert_eq(s.line_count(), 1)
    assert_eq(s.locate(0), Loc(1, 1))
end an_empty_input_has_one_line

@test
lines_are_counted_from_one()
    val s = source_of("t", "ab\ncd\n\nef")

    assert_eq(s.line_count(), 4)
    assert_eq(s.locate(0), Loc(1, 1))
    assert_eq(s.locate(1), Loc(1, 2))
    assert_eq(s.locate(3), Loc(2, 1))
    assert_eq(s.locate(6), Loc(3, 1))
    assert_eq(s.locate(7), Loc(4, 1))
end lines_are_counted_from_one

@test
an_offset_past_the_end_lands_after_the_last_character()
    val s = source_of("t", "ab")

    assert_eq(s.locate(2), Loc(1, 3))
    assert_eq(s.locate(99), Loc(1, 3))
end an_offset_past_the_end_lands_after_the_last_character

@test
a_column_counts_characters_and_not_bytes()
    val s = source_of("t", "héllo")

    assert_eq(s.locate(1), Loc(1, 2))
    assert_eq(s.locate(3), Loc(1, 3))
end a_column_counts_characters_and_not_bytes

// The end of an input that ends in a newline is the start of an empty line, and a diagnostic about
// something missing at the end of the file has to have somewhere to point.
@test
a_trailing_newline_opens_an_empty_last_line()
    val s = source_of("t", "ab\n")

    assert_eq(s.line_count(), 2)
    assert_eq(s.locate(3), Loc(2, 1))
    assert(s.line_span(2).is_empty(), "the last line is empty")
end a_trailing_newline_opens_an_empty_last_line

@test
a_line_is_handed_back_without_its_terminator()
    val s = source_of("t", "ab\r\ncd\n")

    assert(sysl.slices.equal(s.line_text(1), "ab".bytes), "the first line")
    assert(sysl.slices.equal(s.line_text(2), "cd".bytes), "the second line")
end a_line_is_handed_back_without_its_terminator

@test
a_span_covers_both_of_its_children()
    assert_eq(Span(2, 4).to(Span(7, 9)), Span(2, 9))
    assert_eq(Span(7, 9).to(Span(2, 4)), Span(2, 9))
    assert(point(3).is_empty(), "a point spans nothing")
end a_span_covers_both_of_its_children

// -- scan -------------------------------------------------------------------------------------

@test
a_scanner_walks_bytes()
    var s = scanner_of("ab")

    assert_eq(s.peek(), Some(u8('a')))
    assert_eq(s.peek_at(1), Some(u8('b')))
    assert_eq(s.peek_at(2), None)
    assert_eq(s.next(), Some(u8('a')))
    assert_eq(s.next(), Some(u8('b')))
    assert_eq(s.next(), None)
    assert(s.at_end(), "the end")
end a_scanner_walks_bytes

@test
a_cursor_saturates_at_the_end()
    var s = scanner_of("a")

    s.bump()
    s.bump()
    s.bump()
    assert_eq(s.offset, 1)
    assert_eq(s.remaining(), 0)
end a_cursor_saturates_at_the_end

@test
accepting_moves_only_on_a_match()
    var s = scanner_of("-1")

    assert(!s.accept(u8('+')), "no plus")
    assert_eq(s.offset, 0)
    assert(s.accept(u8('-')), "a minus")
    assert_eq(s.offset, 1)
end accepting_moves_only_on_a_match

@test
a_run_is_all_or_nothing()
    var s = scanner_of("-->x")

    assert(!s.accept_seq("--!".bytes), "a partial match moves nothing")
    assert_eq(s.offset, 0)
    assert(s.starts_with("-->".bytes), "starts_with")
    assert(s.accept_seq("-->".bytes), "the whole run")
    assert_eq(s.offset, 3)
end a_run_is_all_or_nothing

@test
accepting_from_a_set_and_by_a_predicate()
    var s = scanner_of("12+")

    assert(s.accept_if(digit), "a digit by a named predicate")
    assert(s.accept_if((c) -> c >= u8('0') && c <= u8('9')), "a digit by a closure")
    assert(!s.accept_any("*/".bytes), "not in the set")
    assert(s.accept_any("+-".bytes), "in the set")
    assert(s.at_end(), "all of it")
end accepting_from_a_set_and_by_a_predicate

@test
runs_report_how_far_they_went()
    var s = scanner_of("123abc")

    assert_eq(s.accept_while(digit), 3)
    assert_eq(s.accept_while(digit), 0)
    assert_eq(s.accept_until(digit), 3)
    assert(s.at_end(), "the end")
end runs_report_how_far_they_went

@test
skip_until_stops_on_the_byte_it_found()
    var s = scanner_of("bad tokens , then")

    assert_eq(s.skip_until(",;".bytes), 11)
    assert_eq(s.peek(), Some(u8(',')))
end skip_until_stops_on_the_byte_it_found

@test
skip_until_stops_at_the_end_when_nothing_is_there()
    var s = scanner_of("nothing here")

    assert_eq(s.skip_until(",;".bytes), 12)
    assert(s.at_end(), "the end")
end skip_until_stops_at_the_end_when_nothing_is_there

@test
a_mark_takes_the_token_and_puts_the_cursor_back()
    var s = scanner_of("let x")
    val m = s.mark()

    assert_eq(s.accept_while(alpha), 3)
    assert_eq(s.span_from(m), Span(0, 3))
    assert(sysl.slices.equal(s.text_from(m), "let".bytes), "the token's own text")

    s.reset(m)
    assert_eq(s.offset, 0)
    assert_eq(s.here(), Span(0, 0))
end a_mark_takes_the_token_and_puts_the_cursor_back

@test
characters_are_read_whole()
    var s = scanner_of("héllo")

    assert_eq(s.next_char(), Some('h'))
    assert_eq(s.peek_char(), Some('é'))
    assert_eq(s.offset, 1)
    assert(s.accept_char('é'), "the accented character")
    assert_eq(s.offset, 3)
    assert(!s.accept_char('x'), "not that one")
    assert_eq(s.offset, 3)
end characters_are_read_whole

private digit(c: u8) -> bool = c >= u8('0') && c <= u8('9')

private alpha(c: u8) -> bool = (c >= u8('a') && c <= u8('z')) || (c >= u8('A') && c <= u8('Z'))

// -- literal ----------------------------------------------------------------------------------

private int_of(text: string) -> Result[ulong, LitError]
    var s = scanner_of(text)

    read_integer(&s)
end int_of

@test
integers_in_every_base()
    assert_eq(int_of("0").unwrap(), 0)
    assert_eq(int_of("42").unwrap(), 42)
    assert_eq(int_of("0xFF").unwrap(), 255)
    assert_eq(int_of("0XfF").unwrap(), 255)
    assert_eq(int_of("0o17").unwrap(), 15)
    assert_eq(int_of("0b1011").unwrap(), 11)
    assert_eq(int_of("007").unwrap(), 7)
end integers_in_every_base

@test
underscores_separate_and_do_not_lead_or_trail()
    assert_eq(int_of("1_000_000").unwrap(), 1000000)
    assert(int_of("_1").is_err(), "a leading underscore")
    assert(int_of("1_").is_err(), "a trailing underscore")
    assert(int_of("1__0").is_err(), "a doubled underscore")
end underscores_separate_and_do_not_lead_or_trail

@test
a_prefix_with_no_digits_is_refused()
    assert(int_of("0x").is_err(), "0x alone")
    assert(int_of("0b").is_err(), "0b alone")
end a_prefix_with_no_digits_is_refused

@test
the_largest_value_fits_and_the_next_one_does_not()
    assert_eq(int_of("18446744073709551615").unwrap(), 18446744073709551615)
    assert(int_of("18446744073709551616").is_err(), "one past the top")
    assert(int_of("0xFFFFFFFFFFFFFFFFF").is_err(), "seventeen hex digits")
end the_largest_value_fits_and_the_next_one_does_not

// An overflowing literal consumes all of its digits, so the grammar resumes after the number rather
// than in the middle of it and reports one error instead of two.
@test
an_overflow_still_consumes_the_whole_number()
    var s = scanner_of("99999999999999999999999 +")

    assert(read_integer(&s).is_err(), "too large")
    assert_eq(s.peek(), Some(u8(' ')))
end an_overflow_still_consumes_the_whole_number

private num_of(text: string) -> Result[Number, LitError]
    var s = scanner_of(text)

    read_number(&s)
end num_of

@test
a_number_is_an_integer_until_something_says_otherwise()
    num_of("12").unwrap() match
        Int(v) -> assert_eq(v, 12)
        Real(_) -> assert(false, "12 is an integer")

    num_of("1.5").unwrap() match
        Int(_) -> assert(false, "1.5 is not an integer")
        Real(x) -> assert_eq(x, 1.5)

    num_of("1e3").unwrap() match
        Int(_) -> assert(false, "1e3 is not an integer")
        Real(x) -> assert_eq(x, 1000.0)

    num_of("2E-2").unwrap() match
        Int(_) -> assert(false, "2E-2 is not an integer")
        Real(x) -> assert_eq(x, 0.02)

    num_of("1_000.5").unwrap() match
        Int(_) -> assert(false, "not an integer")
        Real(x) -> assert_eq(x, 1000.5)
end a_number_is_an_integer_until_something_says_otherwise

// The dot belongs to the number only when a digit follows it, which is what keeps `0..<n` and
// `1.max()` readable without a space.
@test
a_dot_with_no_digit_after_it_is_not_part_of_the_number()
    var s = scanner_of("0..<8")

    s.offset

    read_number(&s).unwrap() match
        Int(v) -> assert_eq(v, 0)
        Real(_) -> assert(false, "not a float")

    assert_eq(s.offset, 1)

    var t = scanner_of("1.max()")

    read_number(&t).unwrap() match
        Int(v) -> assert_eq(v, 1)
        Real(_) -> assert(false, "not a float")

    assert_eq(t.offset, 1)
end a_dot_with_no_digit_after_it_is_not_part_of_the_number

@test
a_prefixed_literal_is_never_a_float()
    var s = scanner_of("0x1.8")

    read_number(&s).unwrap() match
        Int(v) -> assert_eq(v, 1)
        Real(_) -> assert(false, "no hexadecimal floats")

    // The dot and the digit after it are left where they are: C's `0x1.8p3` is a hexadecimal float
    // and this is not a reader of one, so what the grammar gets back is the integer and a cursor
    // pointing at something it has to decide about itself.
    assert_eq(s.offset, 3)
end a_prefixed_literal_is_never_a_float

private quoted(text: string) -> Result[string, LitError]
    var s = scanner_of(text)

    read_quoted(&s, u8('"'))
end quoted

@test
escapes_decode()
    assert_eq(quoted("\"a\\nb\"").unwrap(), "a\nb")
    assert_eq(quoted("\"\\t\\r\\\\\\\"\"").unwrap(), "\t\r\\\"")
    assert_eq(quoted("\"\\x41\"").unwrap(), "A")
    assert_eq(quoted("\"\\u0041\"").unwrap(), "A")
    assert_eq(quoted("\"\\u{1F600}\"").unwrap(), "😀")
end escapes_decode

// JSON writes an astral character as a UTF-16 pair and UTF-8 has no such thing, so the pair is put
// back together here or the text comes out as two errors.
@test
a_surrogate_pair_is_one_character()
    assert_eq(quoted("\"\\ud83d\\ude00\"").unwrap(), "😀")
    assert(quoted("\"\\ud83d\"").is_err(), "a high surrogate alone")
    assert(quoted("\"\\ude00\"").is_err(), "a low surrogate alone")
    assert(quoted("\"\\ud83dx\"").is_err(), "a pair that is not one")
end a_surrogate_pair_is_one_character

@test
a_quote_that_never_closes_is_refused()
    assert(quoted("\"abc").is_err(), "no closing quote")
    assert(quoted("\"abc\\").is_err(), "ends inside an escape")
    assert(quoted("abc").is_err(), "no opening quote")
end a_quote_that_never_closes_is_refused

// **Every refusal carries an extent, not a place**, which is the difference between a caret under
// one character and a caret under the thing that was wrong. The compiler's own `Pos` carries a start
// and an end for the same reason, and these are the spans a reader actually sees underlined.
@test
a_refusal_underlines_what_was_wrong()
    var s = scanner_of("\"a\\qb\"")

    read_quoted(&s, u8('"')) match
        Ok(_) -> assert(false, "q is not an escape")
        // The whole escape, `\q`, and not the backslash alone.
        Err(e) -> assert_eq(where(e), Span(2, 4))

    var t = scanner_of("0x")

    read_integer(&t) match
        Ok(_) -> assert(false, "no digits")
        // The prefix, since the digits that are missing have no span of their own.
        Err(e) -> assert_eq(where(e), Span(0, 2))

    var u = scanner_of("1__0")

    read_integer(&u) match
        Ok(_) -> assert(false, "a doubled underscore")
        Err(e) -> assert_eq(where(e), Span(2, 3))

    var v = scanner_of("\"\\ud83dx\"")

    read_quoted(&v, u8('"')) match
        Ok(_) -> assert(false, "a lone high surrogate")
        // All six bytes of the escape, so the reader sees the digits that named it.
        Err(e) -> assert_eq(where(e), Span(1, 7))

    var w = scanner_of("''")

    read_char_literal(&w, u8('\'')) match
        Ok(_) -> assert(false, "nothing between the quotes")
        // Both quotes: what is wrong is the pair, and there is nothing between them to point at.
        // And what it says is about characters, since that is what the reader was asked for.
        Err(e) ->
            assert_eq(where(e), Span(0, 2))
            assert_eq(str(e), "not a character")

    var x = scanner_of("99999999999999999999999")

    read_integer(&x) match
        Ok(_) -> assert(false, "too large")
        // The whole number, since that is what has to change.
        Err(e) -> assert_eq(where(e), Span(0, 23))
end a_refusal_underlines_what_was_wrong

@test
text_outside_the_escapes_is_copied_whole()
    assert_eq(quoted("\"héllo wörld\"").unwrap(), "héllo wörld")
    assert_eq(quoted("\"\"").unwrap(), "")
end text_outside_the_escapes_is_copied_whole

@test
a_character_literal_holds_exactly_one()
    var s = scanner_of("'a'")

    assert_eq(read_char_literal(&s, u8('\'')).unwrap(), 'a')

    var t = scanner_of("'\\n'")

    assert_eq(read_char_literal(&t, u8('\'')).unwrap(), '\n')

    var u = scanner_of("'é'")

    assert_eq(read_char_literal(&u, u8('\'')).unwrap(), 'é')

    var v = scanner_of("''")

    assert(read_char_literal(&v, u8('\'')).is_err(), "nothing between the quotes")

    var w = scanner_of("'ab'")

    assert(read_char_literal(&w, u8('\'')).is_err(), "two characters")
end a_character_literal_holds_exactly_one

// -- classes ----------------------------------------------------------------------------------

@test
a_byte_set_holds_what_was_put_in_it()
    val s = byte_set_of("+-*/")

    assert(s.has(u8('+')), "plus")
    assert(s.has(u8('/')), "slash")
    assert(!s.has(u8('x')), "not x")
    assert_eq(s.size(), 4)
    assert(empty_set().is_empty(), "nothing in the empty set")
end a_byte_set_holds_what_was_put_in_it

@test
a_set_covers_every_byte_and_not_only_the_ascii_ones()
    val s = byte_set_where(is_non_ascii)

    assert(s.has(255), "the last byte")
    assert(s.has(128), "the first non-ascii one")
    assert(!s.has(127), "not the last ascii one")
    assert_eq(s.size(), 128)
end a_set_covers_every_byte_and_not_only_the_ascii_ones

@test
sets_combine()
    val letters = byte_range(u8('a'), u8('z'))
    val digits = byte_set_where(is_digit)
    val both = letters.union(digits)

    assert_eq(letters.size(), 26)
    assert_eq(both.size(), 36)
    assert_eq(both.intersect(digits).size(), 10)
    assert_eq(both.without(digits).size(), 26)
    assert_eq(letters.invert().size(), 230)
    assert(!letters.invert().has(u8('a')), "the complement")
end sets_combine

@test
identifier_classes_are_the_c_family_ones()
    assert(is_ident_start(u8('_')), "underscore starts one")
    assert(!is_ident_start(u8('9')), "a digit does not")
    assert(is_ident_cont(u8('9')), "a digit continues one")
end identifier_classes_are_the_c_family_ones

// -- scanner helpers --------------------------------------------------------------------------

@test
a_set_drives_the_cursor()
    val ident = byte_set_where(is_ident_cont)
    var s = scanner_of("name_1 rest")

    assert_eq(s.accept_while_set(ident), 6)
    assert(!s.accept_set(ident), "a space is not in it")
    assert_eq(s.skip_until_set(byte_set_of("t")), 4)
end a_set_drives_the_cursor

@test
looking_ahead_moves_nothing()
    var s = scanner_of("===x")

    assert_eq(s.peek_while((c) -> c == u8('=')), 3)
    assert_eq(s.offset, 0)
    assert_eq(s.find(u8('x')), Some(3))
    assert_eq(s.find(u8('q')), None)
    assert_eq(s.offset, 0)
end looking_ahead_moves_nothing

@test
blanks_stop_at_a_newline_and_space_does_not()
    var s = scanner_of("  \n  x")

    assert_eq(s.skip_blanks(), 2)
    assert(s.at_line_end(), "on the newline")

    var t = scanner_of("  \n  x")

    assert_eq(t.skip_space(), 5)
    assert_eq(t.peek(), Some(u8('x')))
end blanks_stop_at_a_newline_and_space_does_not

// A file written on either kind of machine has to look the same to a grammar that counts lines.
@test
crlf_is_one_line_ending()
    var s = scanner_of("a\r\nb\nc")
    var lines = 0

    while !s.at_end()
        s.skip_to_line_end()

        if s.accept_newline() then lines += 1

    assert_eq(lines, 2)
end crlf_is_one_line_ending

// **A bare `\r` is a line ending too**, which is the case the two-byte-slice version got for free from
// its trailing `|| accept('\r')` and which the byte-test version has to be checked for on purpose.
// Classic Mac text is the reason anybody meets one; a stray `\r` from a serial line is the reason
// anybody meets one *now*.
@test
a_bare_carriage_return_is_a_line_ending()
    var s = scanner_of("a\rb")

    s.skip_to_line_end()

    assert(s.accept_newline(), "the lone carriage return")
    assert_eq(s.offset, 2)
end a_bare_carriage_return_is_a_line_ending

// And it must not eat the character after it, which is the way a two-byte reader gets this wrong: a
// `\r` followed by anything other than `\n` is one byte of ending and no more.
@test
a_carriage_return_takes_only_a_newline_with_it()
    var s = scanner_of("\rx")

    assert(s.accept_newline(), "the ending")
    assert_eq(s.peek(), Some(u8('x')))
end a_carriage_return_takes_only_a_newline_with_it

@test
comments_run_to_the_end_of_the_line()
    var s = scanner_of("// gone\nkept")

    assert(s.skip_line_comment("//".bytes), "a comment")
    assert(s.at_line_end(), "stopped on the newline")
    assert(!s.skip_line_comment("//".bytes), "not a comment")

    s.accept_newline()
    assert_eq(s.peek(), Some(u8('k')))
end comments_run_to_the_end_of_the_line

@test
block_comments_nest_when_the_language_says_they_do()
    var s = scanner_of("/* a /* b */ c */x")

    assert_eq(s.skip_block_comment("/*".bytes, "*/".bytes, true), Ok(true))
    assert_eq(s.peek(), Some(u8('x')))

    var t = scanner_of("/* a /* b */ c */x")

    assert_eq(t.skip_block_comment("/*".bytes, "*/".bytes, false), Ok(true))
    assert_eq(t.peek(), Some(u8(' ')))

    var u = scanner_of("plain")

    assert_eq(u.skip_block_comment("/*".bytes, "*/".bytes, false), Ok(false))
    assert_eq(u.offset, 0)
end block_comments_nest_when_the_language_says_they_do

@test
a_comment_that_never_closes_reports_where_it_started()
    var s = scanner_of("x /* forever")

    s.skip(2)
    assert_eq(s.skip_block_comment("/*".bytes, "*/".bytes, false), Err(Span(2, 12)))
end a_comment_that_never_closes_reports_where_it_started

// The check every hand-written lexer forgets once: a keyword that swallows the front of a longer
// identifier.
@test
a_keyword_is_only_a_keyword_when_the_word_ends()
    var s = scanner_of("ifx")

    assert(!s.accept_word("if".bytes, is_ident_cont), "ifx is not if")
    assert_eq(s.offset, 0)

    var t = scanner_of("if (")

    assert(t.accept_word("if".bytes, is_ident_cont), "if is")
    assert_eq(t.offset, 2)

    var u = scanner_of("if")

    assert(u.accept_word("if".bytes, is_ident_cont), "at the end of the input")
end a_keyword_is_only_a_keyword_when_the_word_ends

@test
identifiers_are_read_as_spans()
    var s = scanner_of("_x9 +")

    assert_eq(s.read_ident(is_ident_start, is_ident_cont), Some(Span(0, 3)))
    assert_eq(s.read_ident(is_ident_start, is_ident_cont), None)
    assert_eq(s.offset, 3)
end identifiers_are_read_as_spans

// `is_empty` answers `true` for a span whose end is before its start, so `len` answers zero for one
// rather than the wrapped subtraction a `usize` would otherwise give.
@test
a_span_that_is_the_wrong_way_round_has_no_length()
    assert_eq(Span(5, 3).len(), 0)
    assert(Span(5, 3).is_empty(), "empty")
    assert_eq(point(4).len(), 0)
    assert_eq(Span(2, 6).len(), 4)
end a_span_that_is_the_wrong_way_round_has_no_length

@test
brackets_are_counted_past()
    var s = scanner_of("(a(b)c)rest")

    assert_eq(s.skip_balanced(u8('('), u8(')')), Ok(Span(0, 7)))
    assert_eq(s.peek(), Some(u8('r')))

    var t = scanner_of("(a(b)c")

    assert_eq(t.skip_balanced(u8('('), u8(')')), Err(Span(0, 6)))
end brackets_are_counted_past

// -- diag -------------------------------------------------------------------------------------

// Compare, and say what the difference was. A rendering's whole contract is its exact text, so a
// failure that only said `false` would leave the reader diffing by eye.
// It is not `private` because the JSON reader in the file beside this one asserts the same way, and
// `private` in sysl is private to the *file*.
same(got: string, want: string, what: string, file: string = __FILE__, line: long = __LINE__)
    if got != want
        print("\n")
        print(what)
        print("\nwanted:\n")
        print(want)
        print("got:\n")
        print(got)

    assert(got == want, what, file, line)
end same

private val json_doc: string = "{\n  \"a\": 1,\n  \"b\": ,\n}\n"

@test
a_diagnostic_renders_the_way_the_compiler_does()
    val src = source_of("config.json", json_doc)
    val d = expected(Span(19, 20), "a value", found_at(src, Span(19, 20)))
        .with_note("a value is a number, a string, `true`, `false`, `null`, an array or an object")

    same(d.render(src),
        "error: expected a value\n" +
        " --> config.json:3:8\n" +
        "  |\n" +
        "3 |   \"b\": ,\n" +
        "  |        ^ found `,`\n" +
        "  |\n" +
        "  = note: a value is a number, a string, `true`, `false`, `null`, an array or an object\n",
        "the whole rendering")
end a_diagnostic_renders_the_way_the_compiler_does

@test
a_caret_is_as_wide_as_its_span()
    val src = source_of("t", "let xyz = 1")

    same(error(Span(4, 7), "unknown name").render(src),
        "error: unknown name\n" +
        " --> t:1:5\n" +
        "  |\n" +
        "1 | let xyz = 1\n" +
        "  |     ^^^\n",
        "three carets")
end a_caret_is_as_wide_as_its_span

// A span of nothing is something *missing*, and a message pointing at zero characters points at
// nothing -- so it still gets one caret.
@test
a_point_still_gets_a_caret()
    val src = source_of("t", "f(1")

    same(error(point(3), "unclosed bracket").render(src),
        "error: unclosed bracket\n" +
        " --> t:1:4\n" +
        "  |\n" +
        "1 | f(1\n" +
        "  |    ^\n",
        "one caret past the end")
end a_point_still_gets_a_caret

// The caret is placed by display width rather than by byte count, so a line with wide characters in
// it still points at the right thing.
@test
a_caret_lands_under_wide_characters()
    val src = source_of("t", "val 日本 = x")

    same(error(Span(11, 12), "here").render(src),
        "error: here\n" +
        " --> t:1:8\n" +
        "  |\n" +
        "1 | val 日本 = x\n" +
        "  |          ^\n",
        "past two wide characters")
end a_caret_lands_under_wide_characters

// What a multi-line span usually means is an unterminated something, and the useful place to point
// is where it started -- so the caret stops at the end of the first line.
@test
a_span_over_several_lines_is_drawn_against_its_first()
    val src = source_of("t", "\"abc\ndef\n")

    same(error(Span(0, 9), "unterminated string").render(src),
        "error: unterminated string\n" +
        " --> t:1:1\n" +
        "  |\n" +
        "1 | \"abc\n" +
        "  | ^^^^\n",
        "capped at the line")
end a_span_over_several_lines_is_drawn_against_its_first

@test
the_gutter_is_as_wide_as_the_line_number()
    var text = ""

    for _ in 0..<9
        text = text + "x\n"

    text = text + "boom\n"

    val src = source_of("t", text)

    same(error(Span(18, 22), "here").render(src),
        "error: here\n" +
        "  --> t:10:1\n" +
        "   |\n" +
        "10 | boom\n" +
        "   | ^^^^\n",
        "a two-digit gutter")
end the_gutter_is_as_wide_as_the_line_number

@test
a_report_sorts_by_position_and_stops_at_its_limit()
    val src = source_of("t", "abcdef")
    var r = report()

    r.limit = 2

    r.add(error(Span(4, 5), "third"))
    r.add(error(Span(0, 1), "first"))
    r.add(error(Span(2, 3), "second"))

    assert_eq(r.len(), 3)
    assert(r.has_errors(), "errors")
    same(r.render(src),
        "error: first\n" +
        " --> t:1:1\n" +
        "  |\n" +
        "1 | abcdef\n" +
        "  | ^\n" +
        "\n" +
        "error: second\n" +
        " --> t:1:3\n" +
        "  |\n" +
        "1 | abcdef\n" +
        "  |   ^\n" +
        "\n" +
        "showing the first 2 of 3\n",
        "sorted and truncated")
end a_report_sorts_by_position_and_stops_at_its_limit

// Two diagnostics at one place are an error and the thing that explains it, so the order the parser
// produced them in is the order that reads -- and `sort_by` is the unstable sort, which says in its
// own documentation that equal elements may come back in any order. Twenty of them is past the
// sixteen below which it falls back to insertion sort and is stable by accident.
@test
a_report_keeps_the_order_it_was_given_at_one_place()
    val src = source_of("t", "x")
    var r = full_report()
    var want = ""

    for i in 0..<20
        r.add(error(point(0), s"m${i}"))

    for i in 0..<20
        if i > 0 then want = want + "\n"

        want = want + s"error: m${i}\n --> t:1:1\n  |\n1 | x\n  | ^\n"

    same(r.render(src), want, "the order the parser produced them")

    // And rendering is a reading rather than a writing: a caller that renders a report and then
    // walks it gets what it added, in the order it added it.
    assert_eq(r.items.at(0).message, "m0")
    assert_eq(r.items.at(19).message, "m19")
end a_report_keeps_the_order_it_was_given_at_one_place

// A line's text stops before its terminator and a `\r\n` is two bytes, so a span pointing at the
// second of them is further into the line than the line's own text goes. The caret is measured off
// that text, and the measurement must not walk past the end of it.
@test
a_caret_survives_a_span_inside_a_windows_line_ending()
    val src = source_of("t", "ab\r\ncd\r\n")

    same(error(point(3), "here").render(src),
        "error: here\n" +
        " --> t:1:4\n" +
        "  |\n" +
        "1 | ab\n" +
        "  |   ^\n",
        "a caret at the end of the line's own text")
end a_caret_survives_a_span_inside_a_windows_line_ending

@test
a_report_of_warnings_alone_is_not_a_failure()
    var r = report()

    r.add(warning(point(0), "careful"))
    assert(!r.has_errors(), "no errors")
    assert(!r.is_empty(), "not empty")
    assert(report().is_empty(), "a fresh report")
end a_report_of_warnings_alone_is_not_a_failure

@test
quoting_the_input_cannot_rearrange_a_message()
    assert_eq(escape_text("a\nb\tc".bytes), "a\\nb\\tc")
    assert_eq(escape_text("\u{1}".bytes), "\\x01")
    assert_eq(escape_text("héllo".bytes), "héllo")
end quoting_the_input_cannot_rearrange_a_message

@test
what_was_found_at_the_end_of_the_input_is_named()
    val src = source_of("t", "ab")

    assert_eq(found_at(src, point(2)), "the end of the input")
    assert_eq(found_at(src, Span(0, 1)), "`a`")
    assert_eq(found_at(src, point(0)), "`a`")
end what_was_found_at_the_end_of_the_input_is_named

// -- tokens and pratt -------------------------------------------------------------------------

// A whole little grammar, because the loop's contract is that a caller can write one: a lexer over
// the scanner tier, a token cursor, three callbacks, and arithmetic that comes out with the right
// answer. Nothing below is scaffolding this package provides -- it is what a consumer writes.

private enum Tok
    Num(v: long)
    Plus
    Minus
    Star
    Slash
    Caret
    Bang
    Open
    Close
end Tok

private lex_expr(text: string) -> Tokens[Tok]
    var s = scanner_of(text)
    var ts: Tokens[Tok] = tokens()

    loop
        s.skip_space()

        val m = s.mark()

        s.next() match
            None -> break
            Some(c) ->
                if is_digit(c) then
                    s.reset(m)

                    read_integer(&s) match
                        Ok(v) -> ts.push(Num(long(v)), s.span_from(m))
                        Err(_) -> break
                elif c == u8('+') then
                    ts.push(Plus, s.span_from(m))
                elif c == u8('-') then
                    ts.push(Minus, s.span_from(m))
                elif c == u8('*') then
                    ts.push(Star, s.span_from(m))
                elif c == u8('/') then
                    ts.push(Slash, s.span_from(m))
                elif c == u8('^') then
                    ts.push(Caret, s.span_from(m))
                elif c == u8('!') then
                    ts.push(Bang, s.span_from(m))
                elif c == u8('(') then
                    ts.push(Open, s.span_from(m))
                elif c == u8(')') then
                    ts.push(Close, s.span_from(m))
                else
                    break

    ts
end lex_expr

// What each operator does to what is around it. `Bang` is postfix and `Open` is a call bracket, and
// neither needs anything of the loop beyond a number.
private power_of(t: Tok) -> Power
    t match
        Plus -> left_assoc(10)
        Minus -> left_assoc(10)
        Star -> left_assoc(20)
        Slash -> left_assoc(20)
        Caret -> right_assoc(30)
        Bang -> left_assoc(40)
        _ -> left_assoc(0)
end power_of

private is_close(t: Tok) -> bool
    t match
        Close -> true
        _ -> false

private is_plus(t: Tok) -> bool
    t match
        Plus -> true
        _ -> false

private expr_lbp(t: Spanned[Tok]) -> u8 = power_of(t.value).left

private expr_nud(t: Spanned[Tok], s: *Tokens[Tok]) -> long
    t.value match
        Num(v) -> v
        // Prefix minus binds more tightly than any infix operator here, which is what makes
        // `-2 ^ 2` read as `(-2) ^ 2` -- a decision the grammar takes by choosing the level it
        // recurses at, and not one the loop has an opinion about.
        Minus -> -expr(s, 35)
        Open ->
            val inner = expr(s, 0)

            val _ = s.accept_if(is_close)

            inner
        _ -> 0
end expr_nud

private expr_led(left: long, t: Spanned[Tok], s: *Tokens[Tok]) -> long
    val bp = power_of(t.value).right

    t.value match
        Plus -> left + expr(s, bp)
        Minus -> left - expr(s, bp)
        Star -> left * expr(s, bp)
        Slash -> left / expr(s, bp)
        Caret -> ipow(left, expr(s, bp))
        // Postfix: it reads nothing at all, which is the whole of what makes it postfix.
        Bang -> factorial(left)
        _ -> left
end expr_led

private expr(s: *Tokens[Tok], min_bp: u8) -> long =
    pratt(s, min_bp, expr_nud, expr_led, expr_lbp).unwrap_or(0)

private ipow(b: long, e: long) -> long
    var r: long = 1

    for _ in 0..<e
        r = r * b

    r
end ipow

private factorial(n: long) -> long
    var r: long = 1

    for i in 2..n
        r = r * i

    r
end factorial

private eval(text: string) -> long
    var ts = lex_expr(text)

    expr(&ts, 0)
end eval

@test
precedence_falls_out_of_the_numbers()
    assert_eq(eval("1 + 2 * 3"), 7)
    assert_eq(eval("2 * 3 + 1"), 7)
    assert_eq(eval("(1 + 2) * 3"), 9)
    assert_eq(eval("100 / 5 / 2"), 10)
end precedence_falls_out_of_the_numbers

// Left and right association are one number apart and nothing else, which is the claim the whole
// module rests on.
@test
association_is_the_difference_between_two_numbers()
    assert_eq(eval("8 - 4 - 2"), 2)
    assert_eq(eval("2 ^ 3 ^ 2"), 512)
    assert_eq(eval("2 ^ 3 * 2"), 16)
end association_is_the_difference_between_two_numbers

// A callback that reads nothing is a postfix operator, and one that reads a bracket is a call --
// neither of which the loop knows anything about.
@test
prefix_and_postfix_are_the_callbacks_business()
    assert_eq(eval("-3 + 1"), -2)
    assert_eq(eval("-2 ^ 2"), 4)
    assert_eq(eval("4 ! + 1"), 25)
    assert_eq(eval("3 * 4 !"), 72)
end prefix_and_postfix_are_the_callbacks_business

@test
an_empty_stream_has_no_expression()
    var ts: Tokens[Tok] = tokens()

    assert_eq(pratt(&ts, 0, expr_nud, expr_led, expr_lbp), None)
end an_empty_stream_has_no_expression

@test
a_token_cursor_knows_where_it_is()
    var ts = lex_expr("1 + 22")

    assert_eq(ts.len(), 3)
    assert_eq(ts.here(), Span(0, 1))

    val m = ts.mark()

    assert_eq(ts.advance().unwrap().span, Span(0, 1))
    assert_eq(ts.previous(), Span(0, 1))
    assert_eq(ts.peek_at(1).unwrap().span, Span(4, 6))

    ts.advance()
    ts.advance()
    assert(ts.at_end(), "the end")
    assert_eq(ts.here(), Span(6, 6))
    assert_eq(ts.span_from(m), Span(0, 6))

    ts.reset(m)
    assert_eq(ts.position, 0)
end a_token_cursor_knows_where_it_is

@test
a_predicate_takes_a_token_only_when_it_matches()
    var ts = lex_expr("+ -")

    // `Tok` carries a payload, so it has no equality unless one is written -- and an `impl` may not
    // sit in a `@tests` file. What a test of a cursor actually needs is whether it moved, which is
    // this.
    //
    // Both spellings, as the scanner's own predicate test does above: a closure whose body is a
    // `match`, and a named predicate where the name is worth having.
    assert(ts.accept_if((t) -> t match
        Minus -> true
        _ -> false).is_none(), "not a minus")
    assert(ts.accept_if(is_plus).is_some(), "the plus")
    assert_eq(ts.position, 1)
end a_predicate_takes_a_token_only_when_it_matches

// -- layout -----------------------------------------------------------------------------------

// One `D` per block closed.
private dedents(n: usize) -> string
    var out = ""

    for _ in 0..<n
        out = out + "D"

    out
end dedents

// A whole indentation pass in twenty lines, which is what the module is for: `I` where a block
// opened, `D` per block closed, `N` at the end of a logical line, `R` where a line lined up with
// nothing. Brackets suppress the line structure inside them.
private dents(text: string) -> string
    var s = scanner_of(text)
    var l = layout()
    var out = ""

    while !s.at_end()
        val indent = measure_indent(&s, 8)

        // A blank line has no indentation of its own, so it is not a line as far as layout is
        // concerned.
        if s.at_line_end() then
            s.accept_newline()
            continue

        if l.significant() then
            val step = l.line(indent.columns) match
                Same -> ""
                Deeper -> "I"
                Shallower(n) -> dedents(n)
                // A ragged line closed real blocks on its way down, so a lexer emits their `DEDENT`s
                // and then says the line lined up with nothing.
                Ragged(n) -> dedents(n) + "R"

            out = out + step

        // The rest of the line, counting the brackets on it, which is all a lexer has to do to make
        // a newline inside them stop meaning anything.
        while !s.at_end() && !s.at_line_end()
            s.next() match
                Some(c) ->
                    if c == u8('(') then
                        l.open_bracket()
                    elif c == u8(')') then
                        // A bracket closing closes every block opened inside it, and the `DEDENT`s
                        // go out before the `)` a lexer is about to emit.
                        out = out + dedents(l.close_bracket())
                    elif c == u8(':') then
                        // This harness's stand-in for whatever token a grammar says opens a block.
                        l.opens_block()
                None -> ()

        val ended = s.accept_newline()

        if ended && l.significant() then out = out + "N"

    for _ in 0..<l.finish()
        out = out + "D"

    out
end dents

@test
a_block_opens_on_a_deeper_line_and_closes_on_a_shallower_one()
    assert_eq(dents("a\n  b\nc\n"), "NINDN")
    assert_eq(dents("a\n  b\n    c\nd\n"), "NININDDN")
end a_block_opens_on_a_deeper_line_and_closes_on_a_shallower_one

@test
everything_still_open_closes_at_the_end_of_the_input()
    assert_eq(dents("a\n  b\n    c\n"), "NININDD")
end everything_still_open_closes_at_the_end_of_the_input

@test
blank_lines_are_not_lines()
    assert_eq(dents("a\n\n\n  b\n"), "NIND")
    assert_eq(dents("a\n   \nb\n"), "NN")
end blank_lines_are_not_lines

// The one indentation mistake people actually make: a line pulled back to a column between two open
// levels. A pass that quietly closed the nearest one would turn it into a parse error elsewhere.
@test
a_line_that_lines_up_with_nothing_is_named()
    assert_eq(dents("a\n    b\n  c\n"), "NINDRN")
end a_line_that_lines_up_with_nothing_is_named

// A ragged line has closed the levels it came down through, and a lexer has to emit a `DEDENT` for
// each of them or its blocks stop matching the layout's. The count is what makes that possible.
@test
a_ragged_line_says_how_many_blocks_it_closed()
    var l = layout()

    assert_eq(l.line(0), Same)
    assert_eq(l.line(4), Deeper)
    assert_eq(l.line(8), Deeper)
    assert_eq(l.depth(), 2)
    assert_eq(l.line(2), Ragged(2))
    assert_eq(l.depth(), 0)
end a_ragged_line_says_how_many_blocks_it_closed

// Without this rule `f(a,\n  b)` is a syntax error in every language that has both features.
@test
a_newline_inside_brackets_means_nothing()
    assert_eq(dents("f(a,\n  b)\nc\n"), "NN")
    assert_eq(dents("f(\n  a\n)\n  b\n"), "NIND")
end a_newline_inside_brackets_means_nothing

@test
a_close_with_nothing_open_does_not_go_negative()
    var l = layout()

    assert_eq(l.close_bracket(), 0)
    assert(l.significant(), "still significant")
    l.open_bracket()
    assert(!l.significant(), "not while one is open")
end a_close_with_nothing_open_does_not_go_negative

@test
a_block_may_open_inside_brackets_once_the_grammar_says_so()
    // The case this exists for: `print(n match` with its arms indented under it. A bracket suspends
    // line structure, and a token the grammar nominates un-suspends it for the block it opens.
    var l = layout()

    l.open_bracket()
    assert(!l.significant(), "a newline inside brackets means nothing")

    l.opens_block()
    assert(l.significant(), "until the grammar says one opens here")

    assert_eq(l.line(4), Deeper)
    assert_eq(l.depth(), 1)
    assert(l.significant(), "and then the block's own lines count")
    assert_eq(l.line(4), Same)
end a_block_may_open_inside_brackets_once_the_grammar_says_so

@test
the_bracket_closes_the_blocks_that_opened_inside_it()
    // No line ending will ever close such a block: the `)` is on the same line as its last arm. So
    // the bracket closes it, and says how many so a lexer can emit the `DEDENT`s.
    var l = layout()

    l.open_bracket()
    l.opens_block()
    assert_eq(l.line(4), Deeper)

    assert_eq(l.close_bracket(), 1)
    assert_eq(l.depth(), 0)
    assert(l.significant(), "back where it started")
end the_bracket_closes_the_blocks_that_opened_inside_it

@test
a_bracket_opened_inside_a_block_still_suspends_that_block()
    // The rule that was there before, which the new one must not break: a block at the top level is
    // suspended by a bracket, and closing that bracket closes nothing.
    var l = layout()

    assert_eq(l.line(4), Deeper)
    l.open_bracket()
    assert(!l.significant(), "suspended by the bracket")

    assert_eq(l.close_bracket(), 0)
    assert(l.significant(), "and resumed by closing it")
    assert_eq(l.depth(), 1)
end a_bracket_opened_inside_a_block_still_suspends_that_block

@test
blocks_and_brackets_nest_to_any_depth()
    var l = layout()

    l.open_bracket()
    l.opens_block()
    assert_eq(l.line(4), Deeper)

    l.open_bracket()
    assert(!l.significant(), "the inner bracket suspends the inner block")

    l.opens_block()
    assert_eq(l.line(8), Deeper)
    assert_eq(l.depth(), 2)

    // The inner `)` closes only what opened inside it.
    assert_eq(l.close_bracket(), 1)
    assert_eq(l.depth(), 1)

    assert_eq(l.close_bracket(), 1)
    assert_eq(l.depth(), 0)
end blocks_and_brackets_nest_to_any_depth

@test
a_separator_closes_the_blocks_that_opened_inside_the_bracket()
    // `apply((x) ->` with a body, and then `, 5)`. The `5` is the call's second argument, so the
    // comma has to close the body -- and no line ending can, for the reason the `)` could not.
    var l = layout()

    l.open_bracket()
    l.opens_block()
    assert_eq(l.line(4), Deeper)

    assert_eq(l.close_blocks_in_bracket(), 1)
    assert_eq(l.depth(), 0)

    // …and the bracket then has nothing left of its own to close.
    assert_eq(l.close_bracket(), 0)
end a_separator_closes_the_blocks_that_opened_inside_the_bracket

@test
a_separator_outside_brackets_closes_nothing()
    // A comma at the top level is an ordinary comma. Only a block that a bracket suspended has no
    // line ending coming for it.
    var l = layout()

    assert_eq(l.line(4), Deeper)
    assert_eq(l.close_blocks_in_bracket(), 0)
    assert_eq(l.depth(), 1)
end a_separator_outside_brackets_closes_nothing

@test
a_separator_leaves_a_block_the_bracket_did_not_open()
    // The block is older than the bracket, so the bracket's separator is written *inside* it and has
    // nothing to say about where it ends. This is the case that makes the test a bracket depth
    // rather than "is a block open".
    var l = layout()

    assert_eq(l.line(4), Deeper)
    l.open_bracket()

    assert_eq(l.close_blocks_in_bracket(), 0)
    assert_eq(l.depth(), 1)
end a_separator_leaves_a_block_the_bracket_did_not_open

@test
a_separator_closes_every_block_the_bracket_opened()
    // Two blocks inside one pair -- an arm whose body opened another. Both end at the comma, and the
    // count is what tells the lexer how many `DEDENT`s to write before it.
    var l = layout()

    l.open_bracket()
    l.opens_block()
    assert_eq(l.line(4), Deeper)
    l.opens_block()
    assert_eq(l.line(8), Deeper)

    assert_eq(l.close_blocks_in_bracket(), 2)
    assert_eq(l.depth(), 0)
end a_separator_closes_every_block_the_bracket_opened

@test
a_block_opener_with_nothing_indented_under_it_just_passes()
    // `f(x match` and then a line at the same column. The flag is spent by the line either way, so
    // the layout does not stay half-open; the grammar reports the missing arms.
    var l = layout()

    l.opens_block()
    assert_eq(l.line(0), Same)
    assert_eq(l.depth(), 0)
end a_block_opener_with_nothing_indented_under_it_just_passes

@test
a_whole_pass_puts_a_block_inside_a_bracket_pair()
    // `:` is this harness's block-opening token. The `D` lands before the line's end, because the
    // `)` is what closed the block.
    assert_eq(dents("f(:\n  a\n  b)\nc\n"), "NINDNN")

@test
brackets_with_no_block_opener_behave_exactly_as_before()
    assert_eq(dents("f(\n  a\n)\n  b\n"), "NIND")

@test
tabs_advance_to_the_next_stop()
    var s = scanner_of("\t x")
    val i = measure_indent(&s, 8)

    assert_eq(i.columns, 9)
    assert_eq(i.tabs, 1)
    assert_eq(i.spaces, 1)
    assert(i.is_mixed(), "both kinds")
    assert_eq(s.peek(), Some(u8('x')))

    var t = scanner_of("  \tx")

    assert_eq(measure_indent(&t, 8).columns, 8)

    var u = scanner_of("\tx")

    assert_eq(measure_indent(&u, 1).columns, 1)
end tabs_advance_to_the_next_stop

@test
the_depth_is_what_is_open()
    var l = layout()

    assert_eq(l.depth(), 0)
    assert_eq(l.line(4), Deeper)
    assert_eq(l.depth(), 1)
    assert_eq(l.line(4), Same)
    assert_eq(l.line(0), Shallower(1))
    assert_eq(l.finish(), 0)
end the_depth_is_what_is_open

@test
the_token_just_taken_can_be_read_back()
    // `previous` answers where it was; this answers what it was. A block-structured grammar needs
    // the second to ask "did a block just close?" when deciding whether a statement has ended.
    var ts = lex_expr("1 + 2")

    assert(ts.looked_back().is_none(), "nothing taken yet")

    ts.advance()
    assert_eq(ts.looked_back().unwrap().span, Span(0, 1))

    ts.advance()
    assert_eq(ts.looked_back().unwrap().span, Span(2, 3))
end the_token_just_taken_can_be_read_back

// -- a literal with expressions written into it ------------------------------------------------

private interp(text: string) -> Result[Interpolation, LitError]
    var s = scanner_of(text)

    read_interpolated(&s, u8('"'), "${".bytes, u8('}'))

private named(text: string) -> Result[Interpolation, LitError]
    var s = scanner_of(text)

    read_interpolated_named(&s, u8('"'), "${".bytes, u8('}'), is_ident_start, is_ident_cont)


@test
an_interpolated_literal_answers_its_chunks_and_its_holes()
    val r = interp("\"a ${x} b\"").unwrap()

    assert_eq(r.chunks.len(), 2)
    assert_eq(r.chunks.at(0), "a ")
    assert_eq(r.chunks.at(1), " b")
    assert_eq(r.holes.len(), 1)

    // The span is the hole's contents, so a caller may hand exactly that to its grammar.
    assert_eq(r.holes.at(0), Span(5, 6))
end an_interpolated_literal_answers_its_chunks_and_its_holes

@test
there_is_one_more_chunk_than_there_are_holes()
    // **Even where the chunks are empty**, which is what keeps the caller's walk a single rule
    // rather than a special case at each end.
    val r = interp("\"${a}${b}\"").unwrap()

    assert_eq(r.chunks.len(), 3)
    assert_eq(r.chunks.at(0), "")
    assert_eq(r.chunks.at(1), "")
    assert_eq(r.chunks.at(2), "")
    assert_eq(r.holes.len(), 2)

    val plain = interp("\"nothing\"").unwrap()

    assert_eq(plain.chunks.len(), 1)
    assert_eq(plain.chunks.at(0), "nothing")
    assert(plain.holes.is_empty())
end there_is_one_more_chunk_than_there_are_holes

@test
a_chunks_escapes_are_read_the_way_a_quoted_literals_are()
    val r = interp("\"a\\tb ${x}\\n\"").unwrap()

    assert_eq(r.chunks.at(0), "a\tb ")
    assert_eq(r.chunks.at(1), "\n")

    // **A doubled sigil is a literal one**, which is the only way to write a `${` where a hole would
    // otherwise open. Nothing is escaped with a backslash here, `$` not being in anyone's escape set.
    val e = interp("\"a $${x} b\"").unwrap()

    assert(e.holes.is_empty())
    assert_eq(e.chunks.len(), 1)
    assert_eq(e.chunks.at(0), "a ${x} b")
end a_chunks_escapes_are_read_the_way_a_quoted_literals_are

@test
a_brace_inside_a_hole_nests_and_one_inside_a_string_does_not()
    // **The whole reason this is not four lines.** A scanner counting braces alone stops in the
    // middle of the argument; one that does not follow a nested string stops at the wrong `}`.
    val nested = interp("\"${ { a: 1 } } tail\"").unwrap()

    assert_eq(nested.chunks.at(1), " tail")

    val quoted = interp("\"${ f(\"}\") } tail\"").unwrap()

    assert_eq(quoted.chunks.at(1), " tail")
    assert_eq(quoted.holes.len(), 1)

    // A quote of either kind, since a grammar may spend both.
    val single = interp("\"${ f('}') } tail\"").unwrap()

    assert_eq(single.chunks.at(1), " tail")
end a_brace_inside_a_hole_nests_and_one_inside_a_string_does_not

@test
a_literal_or_a_hole_that_never_closes_is_refused()
    assert(interp("\"a ${x} b").is_err(), "the literal runs out")
    assert(interp("\"a ${x").is_err(), "the hole runs out")
    assert(interp("\"a ${ \"unclosed").is_err(), "a string inside the hole runs out")

@test
the_opener_and_the_closer_are_the_callers()
    var s = scanner_of("\"a #{x} b\"")
    val r = read_interpolated(&s, u8('"'), "#{".bytes, u8('}')).unwrap()

    assert_eq(r.chunks.at(0), "a ")
    assert_eq(r.holes.len(), 1)
end the_opener_and_the_closer_are_the_callers

@test
a_bare_name_after_the_sigil_is_a_hole_too()
    // Scala's short form, and the one a program reaches for when the hole is a single name.

    val r = named("\"$w by $h\"").unwrap()

    assert_eq(r.chunks.len(), 3)
    assert_eq(r.chunks.at(0), "")
    assert_eq(r.chunks.at(1), " by ")
    assert_eq(r.chunks.at(2), "")
    assert_eq(r.holes.len(), 2)

@test
a_bare_hole_spans_exactly_its_name()
    // The span is what the caller re-reads to get the expression, so it has to cover the name and
    // neither the sigil before it nor the byte that ended it.

    val r = named("\"a $wide b\"").unwrap()

    assert_eq(r.holes.at(0), Span(4, 8))

@test
A_DOUBLED_SIGIL_STAYS_A_SIGIL_WHEN_BARE_NAMES_ARE_ON()
    // **The case the whole entry point exists for.** `$$w` is a literal `$` and then a `w`, and `$w`
    // is a hole -- they decode to the same three characters, so a caller handed only the chunks
    // could never tell them apart. Getting this wrong is silent, which is why it is pinned.

    val doubled = named("\"$$w\"").unwrap()

    assert_eq(doubled.holes.len(), 0)
    assert_eq(doubled.chunks.at(0), "$w")

    val bare = named("\"$w\"").unwrap()

    assert_eq(bare.holes.len(), 1)

@test
a_bare_name_stops_at_the_first_byte_that_cannot_continue_one()
    // Identifier-only, so `$point.x` is `point` and then literal `.x`. `${point.x}` says the other
    // thing, and a reader never has to work out where the hole ended.

    val r = named("\"$point.x\"").unwrap()

    assert_eq(r.holes.len(), 1)
    assert_eq(r.chunks.at(1), ".x")

@test
BOTH_FORMS_STAND_IN_ONE_LITERAL()
    val r = named("\"$a and ${b + c}\"").unwrap()

    assert_eq(r.holes.len(), 2)
    assert_eq(r.chunks.at(1), " and ")

@test
A_SIGIL_THAT_BEGINS_NO_NAME_IS_ORDINARY_TEXT()
    // **A trailing `$`, and a `$` before a digit or a space.** None of them opens a hole, so each is
    // the character it looks like -- which is what keeps a price or a shell snippet readable.

    assert_eq(named("\"costs 5$\"").unwrap().chunks.at(0), "costs 5$")
    assert_eq(named("\"$ x\"").unwrap().chunks.at(0), "$ x")
    assert_eq(named("\"$1\"").unwrap().chunks.at(0), "$1")

@test
THE_BARE_FORM_IS_OFF_FOR_read_interpolated()
    // **The compatibility guarantee, asserted rather than assumed.** Every grammar already using
    // this reader keeps the literals it has: a `$` before a letter is text, as it always was.

    val r = interp("\"$w by $h\"").unwrap()

    assert_eq(r.holes.len(), 0)
    assert_eq(r.chunks.at(0), "$w by $h")

@test
the_bare_sigil_follows_the_opener_the_caller_gave()
    // `#{` makes `#name` the short form, for the same reason it makes `#{...}` the long one -- the
    // sigil is one decision, not two.

    var s = scanner_of("\"a #x b\"")
    val r = read_interpolated_named(&s, u8('"'), "#{".bytes, u8('}'), is_ident_start, is_ident_cont).unwrap()

    assert_eq(r.holes.len(), 1)
    assert_eq(r.chunks.at(0), "a ")
    assert_eq(r.chunks.at(1), " b")

// -- re-reading one slice of a source -----------------------------------------------------------

@test
a_sub_source_keeps_every_offset_line_and_column()
    // **The reason it is not a substring.** A grammar re-reading part of its input gets spans
    // measured from the slice, so every diagnostic in it names a place nobody can find.
    val src = source_of("t", "one\ntwo\nthree\n")
    val sub = sub_source(src, Span(8, 13))

    assert_eq(sub.bytes.len, src.bytes.len)
    assert_eq(sub.text(Span(8, 13)), "three".bytes)

    // The line the slice is on is the line it was on, and the column too -- which is what keeps a
    // caret under the character the reader is looking at.
    assert_eq(src.locate(8), sub.locate(8))
    assert_eq(sub.locate(8).line, 3)

    // Everything outside is blank, so nothing outside lexes.
    assert_eq(sub.text(Span(0, 3)), "   ".bytes)
end a_sub_source_keeps_every_offset_line_and_column

// -- gathering what another report collected ----------------------------------------------------

@test
a_report_takes_what_another_one_gathered()
    var a = report()
    var b = report()

    a.add(error(Span(0, 1), "first"))
    b.add(error(Span(2, 3), "second"))
    b.add(warning(Span(4, 5), "third"))
    a.absorb(b)

    assert_eq(a.len(), 3)
    assert_eq(a.at(1).message, "second")

    // The one it took from is untouched, so a caller may read it afterwards.
    assert_eq(b.len(), 2)
end a_report_takes_what_another_one_gathered

// The four readers a grammar reaches for when its literals are not C's, added at 0.5.0 and driven
// out of writing `sysl-lang/toml`. Each one is a shape rather than a policy: what a run of
// delimiters *means*, what `n` hexadecimal digits *name*. Whether a language has the form at all is
// still the language's answer.

// `\U` is C's other universal character name and was the one escape missing from a set this file
// says is the C family's. Nothing was silently wrong before -- `\U0001F600` was refused as an
// unknown escape -- it simply could not be written.
@test
the_eight_digit_universal_character_name()
    assert_eq(quoted("\"\\U0001F600\"").unwrap(), "😀")
    assert_eq(quoted("\"\\U00000041\"").unwrap(), "A")

    // Seven digits is not the escape, and neither is a codepoint past the end of the space.
    assert(quoted("\"\\U000041\"").is_err(), "too few digits")
    assert(quoted("\"\\U00110000\"").is_err(), "past U+10FFFF")

// The machinery `read_escape` uses, made public so that a grammar whose escapes are not C's can read
// its own -- which is every grammar with a fixed-width hexadecimal escape, since the surrogate test
// is the line a hand-written version leaves out.
@test
a_fixed_width_hexadecimal_escape_is_readable_on_its_own()
    var s = scanner_of("0041")

    assert_eq(read_hex_escape(&s, 4, 0).unwrap(), 'A')
    assert_eq(s.offset, 4)

    var bad = scanner_of("d800")

    assert(read_hex_escape(&bad, 4, 0).is_err(), "a surrogate is not a character")

    var short = scanner_of("41")

    assert(read_hex_escape(&short, 4, 0).is_err(), "the input ran out")

// A raw literal is what a Windows path and a regular expression are written in, and its whole rule is
// that the backslash is a backslash.
@test
a_raw_literal_decodes_nothing()
    var s = scanner_of("'C:\\Users\\n'")

    assert_eq(read_raw(&s, u8('\'')).unwrap(), "C:\\Users\\n")
    assert(s.at_end())

    var empty = scanner_of("''")

    assert_eq(read_raw(&empty, u8('\'')).unwrap(), "")

    var open = scanner_of("'never closed")

    assert(read_raw(&open, u8('\'')).is_err(), "the input ran out")

    // The quote is the caller's, exactly as `read_quoted`'s is.
    var back = scanner_of("`raw`")

    assert_eq(read_raw(&back, u8('`')).unwrap(), "raw")

// The rule every fenced-literal implementation gets wrong in the same direction: it stops at the
// first three delimiters it sees, and a string ending in the delimiter comes out short.
@test
a_fence_lets_two_delimiters_belong_to_the_text()
    var one = scanner_of("\"x")

    assert_eq(fence_run(&one, u8('"')), Text(1))

    var two = scanner_of("\"\"x")

    assert_eq(fence_run(&two, u8('"')), Text(2))

    var three = scanner_of("\"\"\"")

    assert_eq(fence_run(&three, u8('"')), Ends(0))

    // `"""he said """"` is `he said "`: four quotes are one of text and then the fence.
    var four = scanner_of("\"\"\"\"")

    assert_eq(fence_run(&four, u8('"')), Ends(1))

    var five = scanner_of("\"\"\"\"\"")

    assert_eq(fence_run(&five, u8('"')), Ends(2))

    var six = scanner_of("\"\"\"\"\"\"")

    assert_eq(fence_run(&six, u8('"')), TooMany)

// **Nothing is consumed**, which is what lets the caller decide where the text goes.
@test
reading_a_fence_moves_no_cursor()
    var s = scanner_of("\"\"\"\"")

    fence_run(&s, u8('"'))
    assert_eq(s.offset, 0)

// -- writing a literal back out ----------------------------------------------------------------

// **The claim is a ROUND TRIP, so that is what is asserted**: whatever goes in comes back out of
// `read_quoted`, for every string that has anything awkward in it. Asserting the exact escaped text
// instead would pin this implementation's spelling rather than the property that matters.
private round_trips(text: string) -> bool
    var s = scanner_of(write_quoted(text, u8('"')))

    read_quoted(&s, u8('"')) match
        Ok(back) -> back == text
        Err(_) -> false
end round_trips

@test
a_written_literal_reads_back_as_what_went_in()
    assert(round_trips(""))
    assert(round_trips("plain"))
    assert(round_trips("a\"b"))
    assert(round_trips("a\\b"))
    assert(round_trips("a\nb\r\tc"))
    assert(round_trips("a\0b"))

    // A control character with no letter of its own, which is the `\xHH` path.
    assert(round_trips("a\u{1}b"))

    // **Above ASCII the bytes are copied**, so this is the case that fails if anything decodes and
    // re-encodes: what comes back would be mojibake rather than the text.
    assert(round_trips("héllo 日本語"))

@test
the_quote_is_the_callers_and_a_backtick_is_not_escaped()
    // The quote character is a parameter for `read_quoted`'s reason -- which one a language uses is
    // the language's business -- so writing with one leaves the other alone.
    assert_eq(write_quoted("a'b", u8('"')), "\"a'b\"")
    assert_eq(write_quoted("a\"b", u8('\'')), "'a\"b'")

    // **`escape_text` escapes a backtick and this does not**, and the difference is the audience: a
    // backtick would close the span a MESSAGE quotes into, and no grammar here has `\`` as an escape
    // for a literal to read back.
    assert_eq(write_quoted("a`b", u8('"')), "\"a`b\"")
    assert_eq(escape_text("a`b".bytes), "a\\`b")

// -- the English a message is written in ---------------------------------------------------------

@test
an_edit_distance_counts_single_character_changes()
    assert_eq(edit_distance("", ""), 0)
    assert_eq(edit_distance("abc", "abc"), 0)
    assert_eq(edit_distance("", "abc"), 3)
    assert_eq(edit_distance("abc", ""), 3)
    assert_eq(edit_distance("abc", "abd"), 1)
    assert_eq(edit_distance("abc", "ab"), 1)
    assert_eq(edit_distance("ab", "abc"), 1)
    assert_eq(edit_distance("recieve", "receive"), 2)

@test
a_guess_is_offered_only_where_it_is_NEARLY_right()
    var names: Buf[string] = buf()

    names.push("length")
    names.push("filter")
    names.push("xs")

    // Two edits in a six-letter name is a typo worth naming.
    assert_eq(nearest_name("lenght", names).unwrap(), "length")
    assert_eq(nearest_name("filtre", names).unwrap(), "filter")

    // **A SHORT name gets ONE edit and no more, which is the whole of why the limit is not a single
    // number.** `ys` is one from `xs` and is offered it; `lenght` is two from `length` and is
    // offered it -- but a three-letter word two edits from something is not a typo, it is a
    // different word, and at that length two edits can reach almost anything.
    assert_eq(nearest_name("ys", names).unwrap(), "xs")
    assert(nearest_name("len", names).is_none())

    // Nothing close at all, which is the ordinary answer.
    assert(nearest_name("wibble", names).is_none())
    assert(nearest_name("anything", buf()).is_none())

@test
a_count_and_an_article_read_as_english()
    assert_eq(counted(0, "argument"), "0 arguments")
    assert_eq(counted(1, "argument"), "1 argument")
    assert_eq(counted(2, "argument"), "2 arguments")

    assert_eq(article("string"), "a")
    assert_eq(article("integer"), "an")
    assert_eq(article("object"), "an")
    assert_eq(article(""), "a")

// -- names in scope while parsing, and the lookahead over a list of them ---------------------------

@test
a_scoped_name_is_in_scope_until_its_region_closes()
    var scope = scoped_names()
    var outer: Buf[string] = buf()

    outer.push("T")
    scope.open_with(outer)

    assert(scope.has("T"))
    assert(!scope.has("U"))
    assert_eq(scope.len(), 1)
    assert_eq(scope.depth(), 1)

    // A region inside it sees both, which is what a definition written inside another wants.
    var inner: Buf[string] = buf()

    inner.push("U")
    scope.open_with(inner)

    assert(scope.has("T"))
    assert(scope.has("U"))
    assert_eq(scope.depth(), 2)

    // And leaving it makes the inner one unspellable again.
    scope.close()

    assert(scope.has("T"))
    assert(!scope.has("U"))

    scope.close()

    assert(!scope.has("T"))
    assert_eq(scope.len(), 0)
    assert_eq(scope.depth(), 0)

@test
a_name_may_be_added_to_a_region_after_it_opens()
    var scope = scoped_names()

    scope.open()
    scope.add("a")
    scope.add("b")

    assert(scope.has("a") && scope.has("b"))

    scope.close()

    assert(!scope.has("a"))

@test
a_scope_left_unclosed_is_cleared_rather_than_carried_into_the_next_parse()
    // **The case this exists for is a file that stopped on a syntax error**, which may have left a
    // region open -- and a leftover name would change what the next file means.
    var scope = scoped_names()

    scope.open()
    scope.add("T")
    scope.clear()

    assert(!scope.has("T"))
    assert_eq(scope.depth(), 0)

    // Closing more regions than were opened does nothing, rather than reaching past the bottom.
    scope.close()

    assert_eq(scope.len(), 0)

// **The variants are spelled apart from everything else in the module on purpose.** A variant name
// is a module-level name here, so a bare `Number` would collide with `literal.sysl`'s own type and
// make it private to this file -- which is a compile error a long way from the line that caused it.
private enum Word
    WName
    WComma
    WOpen
    WClose
    WOther
end Word

private words(kinds: Buf[Word]) -> Tokens[Word]
    var ts: Tokens[Word] = tokens()

    for i in 0..<kinds.len()
        ts.push(kinds.at(i), point(i))

    ts
end words

private word_list(text: string) -> Tokens[Word]
    var kinds: Buf[Word] = buf()

    for i in 0..<text.len
        val c = text.bytes[i]

        kinds.push(if c == u8('n') then WName elif c == u8(',') then WComma elif c == u8('[') then WOpen elif c == u8(']') then WClose else WOther)

    words(kinds)
end word_list

@test
a_bracketed_list_of_bare_names_is_told_from_everything_else()
    // `[n]`, `[n, n]` -- a list, and the answer is where it ended.
    assert_eq(names_end(word_list("[n]"), 0, WOpen, WClose, WComma, WName), Some(3))
    assert_eq(names_end(word_list("[n,n]"), 0, WOpen, WClose, WComma, WName), Some(5))

    // The scan starts where it is told to, so a head is stepped over by the caller.
    assert_eq(names_end(word_list("n[n]"), 1, WOpen, WClose, WComma, WName), Some(4))

    // **Anything but a name inside makes it not a list**, which is what separates `first[T](xs)`
    // from `handlers[0](x)`.
    assert(names_end(word_list("[0]"), 0, WOpen, WClose, WComma, WName).is_none())
    assert(names_end(word_list("[n,0]"), 0, WOpen, WClose, WComma, WName).is_none())

    // So does an empty pair, a list of no names not being a list of names.
    assert(names_end(word_list("[]"), 0, WOpen, WClose, WComma, WName).is_none())

    // So does a trailing separator, and text that runs out before the bracket closes.
    assert(names_end(word_list("[n,]"), 0, WOpen, WClose, WComma, WName).is_none())
    assert(names_end(word_list("[n"), 0, WOpen, WClose, WComma, WName).is_none())

    // And so does no opening bracket at all, which is the ordinary answer at most positions.
    assert(names_end(word_list("n"), 0, WOpen, WClose, WComma, WName).is_none())
    assert(names_end(word_list(""), 0, WOpen, WClose, WComma, WName).is_none())
